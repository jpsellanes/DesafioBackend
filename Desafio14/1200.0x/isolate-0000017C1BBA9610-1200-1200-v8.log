script-source,574,C:\\Users\\sella\\Desktop\\Programacion\\CoderHouse\\Backend\\Desafio14\\node_modules\\winston\\lib\\winston\\profiler.js,/**\x0d\n * profiler.js: TODO: add file header description.\x0d\n *\x0d\n * (C) 2010 Charlie Robbins\x0d\n * MIT LICENCE\x0d\n */\x0d\n\x0d\n'use strict';\x0d\n\x0d\n/**\x0d\n * TODO: add class description.\x0d\n * @type {Profiler}\x0d\n * @private\x0d\n */\x0d\nmodule.exports = class Profiler {\x0d\n  /**\x0d\n   * Constructor function for the Profiler instance used by\x0d\n   * `Logger.prototype.startTimer`. When done is called the timer will finish\x0d\n   * and log the duration.\x0d\n   * @param {!Logger} logger - TODO: add param description.\x0d\n   * @private\x0d\n   */\x0d\n  constructor(logger) {\x0d\n    if (!logger) {\x0d\n      throw new Error('Logger is required for profiling.');\x0d\n    }\x0d\n\x0d\n    this.logger = logger;\x0d\n    this.start = Date.now();\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * Ends the current timer (i.e. Profiler) instance and logs the `msg` along\x0d\n   * with the duration since creation.\x0d\n   * @returns {mixed} - TODO: add return description.\x0d\n   * @private\x0d\n   */\x0d\n  done(...args) {\x0d\n    if (typeof args[args.length - 1] === 'function') {\x0d\n      // eslint-disable-next-line no-console\x0d\n      console.warn('Callback function no longer supported as of winston@3.0.0');\x0d\n      args.pop();\x0d\n    }\x0d\n\x0d\n    const info = typeof args[args.length - 1] === 'object' ? args.pop() : {};\x0d\n    info.level = info.level || 'info';\x0d\n    info.durationMs = (Date.now()) - this.start;\x0d\n\x0d\n    return this.logger.write(info);\x0d\n  }\x0d\n};\x0d\n
