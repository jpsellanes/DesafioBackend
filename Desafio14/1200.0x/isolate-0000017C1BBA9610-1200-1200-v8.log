script-source,560,C:\\Users\\sella\\Desktop\\Programacion\\CoderHouse\\Backend\\Desafio14\\node_modules\\color\\node_modules\\color-convert\\route.js,var conversions = require('./conversions');\n\n/*\n\x09this function routes a model to all other models.\n\n\x09all functions that are routed have a property `.conversion` attached\n\x09to the returned synthetic function. This property is an array\n\x09of strings\x2C each with the steps in between the 'from' and 'to'\n\x09color models (inclusive).\n\n\x09conversions that are not possible simply are not included.\n*/\n\nfunction buildGraph() {\n\x09var graph = {};\n\x09// https://jsperf.com/object-keys-vs-for-in-with-closure/3\n\x09var models = Object.keys(conversions);\n\n\x09for (var len = models.length\x2C i = 0; i < len; i++) {\n\x09\x09graph[models[i]] = {\n\x09\x09\x09// http://jsperf.com/1-vs-infinity\n\x09\x09\x09// micro-opt\x2C but this is simple.\n\x09\x09\x09distance: -1\x2C\n\x09\x09\x09parent: null\n\x09\x09};\n\x09}\n\n\x09return graph;\n}\n\n// https://en.wikipedia.org/wiki/Breadth-first_search\nfunction deriveBFS(fromModel) {\n\x09var graph = buildGraph();\n\x09var queue = [fromModel]; // unshift -> queue -> pop\n\n\x09graph[fromModel].distance = 0;\n\n\x09while (queue.length) {\n\x09\x09var current = queue.pop();\n\x09\x09var adjacents = Object.keys(conversions[current]);\n\n\x09\x09for (var len = adjacents.length\x2C i = 0; i < len; i++) {\n\x09\x09\x09var adjacent = adjacents[i];\n\x09\x09\x09var node = graph[adjacent];\n\n\x09\x09\x09if (node.distance === -1) {\n\x09\x09\x09\x09node.distance = graph[current].distance + 1;\n\x09\x09\x09\x09node.parent = current;\n\x09\x09\x09\x09queue.unshift(adjacent);\n\x09\x09\x09}\n\x09\x09}\n\x09}\n\n\x09return graph;\n}\n\nfunction link(from\x2C to) {\n\x09return function (args) {\n\x09\x09return to(from(args));\n\x09};\n}\n\nfunction wrapConversion(toModel\x2C graph) {\n\x09var path = [graph[toModel].parent\x2C toModel];\n\x09var fn = conversions[graph[toModel].parent][toModel];\n\n\x09var cur = graph[toModel].parent;\n\x09while (graph[cur].parent) {\n\x09\x09path.unshift(graph[cur].parent);\n\x09\x09fn = link(conversions[graph[cur].parent][cur]\x2C fn);\n\x09\x09cur = graph[cur].parent;\n\x09}\n\n\x09fn.conversion = path;\n\x09return fn;\n}\n\nmodule.exports = function (fromModel) {\n\x09var graph = deriveBFS(fromModel);\n\x09var conversion = {};\n\n\x09var models = Object.keys(graph);\n\x09for (var len = models.length\x2C i = 0; i < len; i++) {\n\x09\x09var toModel = models[i];\n\x09\x09var node = graph[toModel];\n\n\x09\x09if (node.parent === null) {\n\x09\x09\x09// no possible conversion\x2C or this node is the source model.\n\x09\x09\x09continue;\n\x09\x09}\n\n\x09\x09conversion[toModel] = wrapConversion(toModel\x2C graph);\n\x09}\n\n\x09return conversion;\n};\n\n
