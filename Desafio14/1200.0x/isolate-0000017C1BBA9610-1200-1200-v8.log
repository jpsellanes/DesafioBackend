script-source,578,C:\\Users\\sella\\Desktop\\Programacion\\CoderHouse\\Backend\\Desafio14\\node_modules\\winston\\lib\\winston\\transports\\console.js,/* eslint-disable no-console */\x0d\n/*\x0d\n * console.js: Transport for outputting to the console.\x0d\n *\x0d\n * (C) 2010 Charlie Robbins\x0d\n * MIT LICENCE\x0d\n */\x0d\n\x0d\n'use strict';\x0d\n\x0d\nconst os = require('os');\x0d\nconst { LEVEL\x2C MESSAGE } = require('triple-beam');\x0d\nconst TransportStream = require('winston-transport');\x0d\n\x0d\n/**\x0d\n * Transport for outputting to the console.\x0d\n * @type {Console}\x0d\n * @extends {TransportStream}\x0d\n */\x0d\nmodule.exports = class Console extends TransportStream {\x0d\n  /**\x0d\n   * Constructor function for the Console transport object responsible for\x0d\n   * persisting log messages and metadata to a terminal or TTY.\x0d\n   * @param {!Object} [options={}] - Options for this instance.\x0d\n   */\x0d\n  constructor(options = {}) {\x0d\n    super(options);\x0d\n\x0d\n    // Expose the name of this Transport on the prototype\x0d\n    this.name = options.name || 'console';\x0d\n    this.stderrLevels = this._stringArrayToSet(options.stderrLevels);\x0d\n    this.consoleWarnLevels = this._stringArrayToSet(options.consoleWarnLevels);\x0d\n    this.eol = (typeof options.eol === 'string') ? options.eol : os.EOL;\x0d\n\x0d\n    this.setMaxListeners(30);\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * Core logging method exposed to Winston.\x0d\n   * @param {Object} info - TODO: add param description.\x0d\n   * @param {Function} callback - TODO: add param description.\x0d\n   * @returns {undefined}\x0d\n   */\x0d\n  log(info\x2C callback) {\x0d\n    setImmediate(() => this.emit('logged'\x2C info));\x0d\n\x0d\n    // Remark: what if there is no raw...?\x0d\n    if (this.stderrLevels[info[LEVEL]]) {\x0d\n      if (console._stderr) {\x0d\n        // Node.js maps `process.stderr` to `console._stderr`.\x0d\n        console._stderr.write(`${info[MESSAGE]}${this.eol}`);\x0d\n      } else {\x0d\n        // console.error adds a newline\x0d\n        console.error(info[MESSAGE]);\x0d\n      }\x0d\n\x0d\n      if (callback) {\x0d\n        callback(); // eslint-disable-line callback-return\x0d\n      }\x0d\n      return;\x0d\n    } else if (this.consoleWarnLevels[info[LEVEL]]) {\x0d\n      if (console._stderr) {\x0d\n        // Node.js maps `process.stderr` to `console._stderr`.\x0d\n        // in Node.js console.warn is an alias for console.error\x0d\n        console._stderr.write(`${info[MESSAGE]}${this.eol}`);\x0d\n      } else {\x0d\n        // console.warn adds a newline\x0d\n        console.warn(info[MESSAGE]);\x0d\n      }\x0d\n\x0d\n      if (callback) {\x0d\n        callback(); // eslint-disable-line callback-return\x0d\n      }\x0d\n      return;\x0d\n    }\x0d\n\x0d\n    if (console._stdout) {\x0d\n      // Node.js maps `process.stdout` to `console._stdout`.\x0d\n      console._stdout.write(`${info[MESSAGE]}${this.eol}`);\x0d\n    } else {\x0d\n      // console.log adds a newline.\x0d\n      console.log(info[MESSAGE]);\x0d\n    }\x0d\n\x0d\n    if (callback) {\x0d\n      callback(); // eslint-disable-line callback-return\x0d\n    }\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * Returns a Set-like object with strArray's elements as keys (each with the\x0d\n   * value true).\x0d\n   * @param {Array} strArray - Array of Set-elements as strings.\x0d\n   * @param {?string} [errMsg] - Custom error message thrown on invalid input.\x0d\n   * @returns {Object} - TODO: add return description.\x0d\n   * @private\x0d\n   */\x0d\n  _stringArrayToSet(strArray\x2C errMsg) {\x0d\n    if (!strArray)\x0d\n      return {};\x0d\n\x0d\n    errMsg = errMsg || 'Cannot make set from type other than Array of string elements';\x0d\n\x0d\n    if (!Array.isArray(strArray)) {\x0d\n      throw new Error(errMsg);\x0d\n    }\x0d\n\x0d\n    return strArray.reduce((set\x2C el) =>  {\x0d\n      if (typeof el !== 'string') {\x0d\n        throw new Error(errMsg);\x0d\n      }\x0d\n      set[el] = true;\x0d\n\x0d\n      return set;\x0d\n    }\x2C {});\x0d\n  }\x0d\n};\x0d\n
