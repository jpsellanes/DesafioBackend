script-source,575,C:\\Users\\sella\\Desktop\\Programacion\\CoderHouse\\Backend\\Desafio14\\node_modules\\winston\\lib\\winston\\container.js,/**\x0d\n * container.js: Inversion of control container for winston logger instances.\x0d\n *\x0d\n * (C) 2010 Charlie Robbins\x0d\n * MIT LICENCE\x0d\n */\x0d\n\x0d\n'use strict';\x0d\n\x0d\nconst createLogger = require('./create-logger');\x0d\n\x0d\n/**\x0d\n * Inversion of control container for winston logger instances.\x0d\n * @type {Container}\x0d\n */\x0d\nmodule.exports = class Container {\x0d\n  /**\x0d\n   * Constructor function for the Container object responsible for managing a\x0d\n   * set of `winston.Logger` instances based on string ids.\x0d\n   * @param {!Object} [options={}] - Default pass-thru options for Loggers.\x0d\n   */\x0d\n  constructor(options = {}) {\x0d\n    this.loggers = new Map();\x0d\n    this.options = options;\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * Retrieves a `winston.Logger` instance for the specified `id`. If an\x0d\n   * instance does not exist\x2C one is created.\x0d\n   * @param {!string} id - The id of the Logger to get.\x0d\n   * @param {?Object} [options] - Options for the Logger instance.\x0d\n   * @returns {Logger} - A configured Logger instance with a specified id.\x0d\n   */\x0d\n  add(id\x2C options) {\x0d\n    if (!this.loggers.has(id)) {\x0d\n      // Remark: Simple shallow clone for configuration options in case we pass\x0d\n      // in instantiated protoypal objects\x0d\n      options = Object.assign({}\x2C options || this.options);\x0d\n      const existing = options.transports || this.options.transports;\x0d\n\x0d\n      // Remark: Make sure if we have an array of transports we slice it to\x0d\n      // make copies of those references.\x0d\n      options.transports = existing ? existing.slice() : [];\x0d\n\x0d\n      const logger = createLogger(options);\x0d\n      logger.on('close'\x2C () => this._delete(id));\x0d\n      this.loggers.set(id\x2C logger);\x0d\n    }\x0d\n\x0d\n    return this.loggers.get(id);\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * Retreives a `winston.Logger` instance for the specified `id`. If\x0d\n   * an instance does not exist\x2C one is created.\x0d\n   * @param {!string} id - The id of the Logger to get.\x0d\n   * @param {?Object} [options] - Options for the Logger instance.\x0d\n   * @returns {Logger} - A configured Logger instance with a specified id.\x0d\n   */\x0d\n  get(id\x2C options) {\x0d\n    return this.add(id\x2C options);\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * Check if the container has a logger with the id.\x0d\n   * @param {?string} id - The id of the Logger instance to find.\x0d\n   * @returns {boolean} - Boolean value indicating if this instance has a\x0d\n   * logger with the specified `id`.\x0d\n   */\x0d\n  has(id) {\x0d\n    return !!this.loggers.has(id);\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * Closes a `Logger` instance with the specified `id` if it exists.\x0d\n   * If no `id` is supplied then all Loggers are closed.\x0d\n   * @param {?string} id - The id of the Logger instance to close.\x0d\n   * @returns {undefined}\x0d\n   */\x0d\n  close(id) {\x0d\n    if (id) {\x0d\n      return this._removeLogger(id);\x0d\n    }\x0d\n\x0d\n    this.loggers.forEach((val\x2C key) => this._removeLogger(key));\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * Remove a logger based on the id.\x0d\n   * @param {!string} id - The id of the logger to remove.\x0d\n   * @returns {undefined}\x0d\n   * @private\x0d\n   */\x0d\n  _removeLogger(id) {\x0d\n    if (!this.loggers.has(id)) {\x0d\n      return;\x0d\n    }\x0d\n\x0d\n    const logger = this.loggers.get(id);\x0d\n    logger.close();\x0d\n    this._delete(id);\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * Deletes a `Logger` instance with the specified `id`.\x0d\n   * @param {!string} id - The id of the Logger instance to delete from\x0d\n   * container.\x0d\n   * @returns {undefined}\x0d\n   * @private\x0d\n   */\x0d\n  _delete(id) {\x0d\n    this.loggers.delete(id);\x0d\n  }\x0d\n};\x0d\n
