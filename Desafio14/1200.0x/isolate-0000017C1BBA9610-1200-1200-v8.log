ublic\n */\nAuthenticator.prototype.serializeUser = function(fn\x2C req\x2C done) {\n  if (typeof fn === 'function') {\n    return this._serializers.push(fn);\n  }\n  \n  // private implementation that traverses the chain of serializers\x2C attempting\n  // to serialize a user\n  var user = fn;\n\n  // For backwards compatibility\n  if (typeof req === 'function') {\n    done = req;\n    req = undefined;\n  }\n  \n  var stack = this._serializers;\n  (function pass(i\x2C err\x2C obj) {\n    // serializers use 'pass' as an error to skip processing\n    if ('pass' === err) {\n      err = undefined;\n    }\n    // an error or serialized object was obtained\x2C done\n    if (err || obj || obj === 0) { return done(err\x2C obj); }\n    \n    var layer = stack[i];\n    if (!layer) {\n      return done(new Error('Failed to serialize user into session'));\n    }\n    \n    \n    function serialized(e\x2C o) {\n      pass(i + 1\x2C e\x2C o);\n    }\n    \n    try {\n      var arity = layer.length;\n      if (arity == 3) {\n        layer(req\x2C user\x2C serialized);\n      } else {\n        layer(user\x2C serialized);\n      }\n    } catch(e) {\n      return done(e);\n    }\n  })(0);\n};\n\n/**\n * Registers a function used to deserialize user objects out of the session.\n *\n * Examples:\n *\n *     passport.deserializeUser(function(id\x2C done) {\n *       User.findById(id\x2C function (err\x2C user) {\n *         done(err\x2C user);\n *       });\n *     });\n *\n * @api public\n */\nAuthenticator.prototype.deserializeUser = function(fn\x2C req\x2C done) {\n  if (typeof fn === 'function') {\n    return this._deserializers.push(fn);\n  }\n  \n  // private implementation that traverses the chain of deserializers\x2C\n  // attempting to deserialize a user\n  var obj = fn;\n\n  // For backwards compatibility\n  if (typeof req === 'function') {\n    done = req;\n    req = undefined;\n  }\n  \n  var stack = this._deserializers;\n  (function pass(i\x2C err\x2C user) {\n    // deserializers use 'pass' as an error to skip processing\n    if ('pass' === err) {\n      err = undefined;\n    }\n    // an error or deserialized user was obtained\x2C done\n    if (err || user) { return done(err\x2C user); }\n    // a valid user existed when establishing the session\x2C but that user has\n    // since been removed\n    if (user === null || user === false) { return done(null\x2C false); }\n    \n    var layer = stack[i];\n    if (!layer) {\n      return done(new Error('Failed to deserialize user out of session'));\n    }\n    \n    \n    function deserialized(e\x2C u) {\n      pass(i + 1\x2C e\x2C u);\n    }\n    \n    try {\n      var arity = layer.length;\n      if (arity == 3) {\n        layer(req\x2C obj\x2C deserialized);\n      } else {\n        layer(obj\x2C deserialized);\n      }\n    } catch(e) {\n      return done(e);\n    }\n  })(0);\n};\n\n/**\n * Registers a function used to transform auth info.\n *\n * In some circumstances authorization details are contained in authentication\n * credentials or loaded as part of verification.\n *\n * For example\x2C when using bearer tokens for API authentication\x2C the tokens may\n * encode (either directly or indirectly in a database)\x2C details such as scope\n * of access or the client to which the token was issued.\n *\n * Such authorization details should be enforced separately from authentication.\n * Because Passport deals only with the latter\x2C this is the responsiblity of\n * middleware or routes further along the chain.  However\x2C it is not optimal to\n * decode the same data or execute the same database query later.  To avoid\n * this\x2C Passport accepts optional `info` along with the authenticated `user`\n * in a strategy's `success()` action.  This info is set at `req.authInfo`\x2C\n * where said later middlware or routes can access it.\n *\n * Optionally\x2C applications can register transforms to proccess this info\x2C\n * which take effect prior to `req.authInfo` being set.  This is useful\x2C for\n * example\x2C when the info contains a client ID.  The transform can load the\n * client from the database and include the instance in the transformed info\x2C\n * allowing the full set of client properties to be convieniently accessed.\n *\n * If no transforms are registered\x2C `info` supplied by the strategy will be left\n * unmodified.\n *\n * Examples:\n *\n *     passport.transformAuthInfo(function(info\x2C done) {\n *       Client.findById(info.clientID\x2C function (err\x2C client) {\n *         info.client = client;\n *         done(err\x2C info);\n *       });\n *     });\n *\n * @api public\n */\nAuthenticator.prototype.transformAuthInfo = function(fn\x2C req\x2C done) {\n  if (typeof fn === 'function') {\n    return this._infoTransformers.push(fn);\n  }\n  \n  // private implementation that traverses the chain of transformers\x2C\n  // attempting to transform auth info\n  var info = fn;\n\n  // For backwards compatibility\n  if (typeof req === 'function') {\n    done = req;\n    req = undefined;\n  }\n  \n  var stack = this._infoTransformers;\n  (function pass(i\x2C err\x2C tinfo) {\n    // transformers use 'pass' as an error to skip processing\n    if ('pass' === err) {\n      err = undefined;\n    }\n    // an error or transformed info was obtained\x2C done\n    if (err || tinfo) { return done(err\x2C tinfo); }\n    \n    var layer = stack[i];\n    if (!layer) {\n      // if no transformers are registered (or they all pass)\x2C the default\n      // behavior is to use the un-transformed info as-is\n      return done(null\x2C info);\n    }\n    \n    \n    function transformed(e\x2C t) {\n      pass(i + 1\x2C e\x2C t);\n    }\n    \n    try {\n      var arity = layer.length;\n      if (arity == 1) {\n        // sync\n        var t = layer(info);\n        transformed(null\x2C t);\n      } else if (arity == 3) {\n        layer(req\x2C info\x2C transformed);\n      } else {\n        layer(info\x2C transformed);\n      }\n    } catch(e) {