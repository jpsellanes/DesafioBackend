script-source,390,node:punycode,'use strict';\x0d\n\x0d\nconst { getOptionValue } = require('internal/options');\x0d\nif (getOptionValue('--pending-deprecation')){\x0d\n\x09process.emitWarning(\x0d\n\x09\x09'The `punycode` module is deprecated. Please use a userland ' +\x0d\n\x09\x09'alternative instead.'\x2C\x0d\n\x09\x09'DeprecationWarning'\x2C\x0d\n\x09\x09'DEP0040'\x2C\x0d\n\x09);\x0d\n}\x0d\n\x0d\n/** Highest positive signed 32-bit float value */\x0d\nconst maxInt = 2147483647; // aka. 0x7FFFFFFF or 2^31-1\x0d\n\x0d\n/** Bootstring parameters */\x0d\nconst base = 36;\x0d\nconst tMin = 1;\x0d\nconst tMax = 26;\x0d\nconst skew = 38;\x0d\nconst damp = 700;\x0d\nconst initialBias = 72;\x0d\nconst initialN = 128; // 0x80\x0d\nconst delimiter = '-'; // '\\x2D'\x0d\n\x0d\n/** Regular expressions */\x0d\nconst regexPunycode = /^xn--/;\x0d\nconst regexNonASCII = /[^\\0-\\x7E]/; // non-ASCII chars\x0d\nconst regexSeparators = /[\\x2E\\u3002\\uFF0E\\uFF61]/g; // RFC 3490 separators\x0d\n\x0d\n/** Error messages */\x0d\nconst errors = {\x0d\n\x09'overflow': 'Overflow: input needs wider integers to process'\x2C\x0d\n\x09'not-basic': 'Illegal input >= 0x80 (not a basic code point)'\x2C\x0d\n\x09'invalid-input': 'Invalid input'\x0d\n};\x0d\n\x0d\n/** Convenience shortcuts */\x0d\nconst baseMinusTMin = base - tMin;\x0d\nconst floor = Math.floor;\x0d\nconst stringFromCharCode = String.fromCharCode;\x0d\n\x0d\n/*--------------------------------------------------------------------------*/\x0d\n\x0d\n/**\x0d\n * A generic error utility function.\x0d\n * @private\x0d\n * @param {String} type The error type.\x0d\n * @returns {Error} Throws a `RangeError` with the applicable error message.\x0d\n */\x0d\nfunction error(type) {\x0d\n\x09throw new RangeError(errors[type]);\x0d\n}\x0d\n\x0d\n/**\x0d\n * A generic `Array#map` utility function.\x0d\n * @private\x0d\n * @param {Array} array The array to iterate over.\x0d\n * @param {Function} callback The function that gets called for every array\x0d\n * item.\x0d\n * @returns {Array} A new array of values returned by the callback function.\x0d\n */\x0d\nfunction map(array\x2C fn) {\x0d\n\x09const result = [];\x0d\n\x09let length = array.length;\x0d\n\x09while (length--) {\x0d\n\x09\x09result[length] = fn(array[length]);\x0d\n\x09}\x0d\n\x09return result;\x0d\n}\x0d\n\x0d\n/**\x0d\n * A simple `Array#map`-like wrapper to work with domain name strings or email\x0d\n * addresses.\x0d\n * @private\x0d\n * @param {String} domain The domain name or email address.\x0d\n * @param {Function} callback The function that gets called for every\x0d\n * character.\x0d\n * @returns {Array} A new string of characters returned by the callback\x0d\n * function.\x0d\n */\x0d\nfunction mapDomain(string\x2C fn) {\x0d\n\x09const parts = string.split('@');\x0d\n\x09let result = '';\x0d\n\x09if (parts.length > 1) {\x0d\n\x09\x09// In email addresses\x2C only the domain name should be punycoded. Leave\x0d\n\x09\x09// the local part (i.e. everything up to `@`) intact.\x0d\n\x09\x09result = parts[0] + '@';\x0d\n\x09\x09string = parts[1];\x0d\n\x09}\x0d\n\x09// Avoid `split(regex)` for IE8 compatibility. See #17.\x0d\n\x09string = string.replace(regexSeparators\x2C '\\x2E');\x0d\n\x09const labels = string.split('.');\x0d\n\x09const encoded = map(labels\x2C fn).join('.');\x0d\n\x09return result + encoded;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Creates an array containing the numeric code points of each Unicode\x0d\n * character in the string. While JavaScript uses UCS-2 internally\x2C\x0d\n * this function will convert a pair of surrogate halves (each of which\x0d\n * UCS-2 exposes as separate characters) into a single code point\x2C\x0d\n * matching UTF-16.\x0d\n * @see `punycode.ucs2.encode`\x0d\n * @see <https://mathiasbynens.be/notes/javascript-encoding>\x0d\n * @memberOf punycode.ucs2\x0d\n * @name decode\x0d\n * @param {String} string The Unicode input string (UCS-2).\x0d\n * @returns {Array} The new array of code points.\x0d\n */\x0d\nfunction ucs2decode(string) {\x0d\n\x09const output = [];\x0d\n\x09let counter = 0;\x0d\n\x09const length = string.length;\x0d\n\x09while (counter < length) {\x0d\n\x09\x09const value = string.charCodeAt(counter++);\x0d\n\x09\x09if (value >= 0xD800 && value <= 0xDBFF && counter < length) {\x0d\n\x09\x09\x09// It's a high surrogate\x2C and there is a next character.\x0d\n\x09\x09\x09const extra = string.charCodeAt(counter++);\x0d\n\x09\x09\x09if ((extra & 0xFC00) == 0xDC00) { // Low surrogate.\x0d\n\x09\x09\x09\x09output.push(((value & 0x3FF) << 10) + (extra & 0x3FF) + 0x10000);\x0d\n\x09\x09\x09} else {\x0d\n\x09\x09\x09\x09// It's an unmatched surrogate; only append this code unit\x2C in case the\x0d\n\x09\x09\x09\x09// next code unit is the high surrogate of a surrogate pair.\x0d\n\x09\x09\x09\x09output.push(value);\x0d\n\x09\x09\x09\x09counter--;\x0d\n\x09\x09\x09}\x0d\n\x09\x09} else {\x0d\n\x09\x09\x09output.push(value);\x0d\n\x09\x09}\x0d\n\x09}\x0d\n\x09return output;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Creates a string based on an array of numeric code points.\x0d\n * @see `punycode.ucs2.decode`\x0d\n * @memberOf punycode.ucs2\x0d\n * @name encode\x0d\n * @param {Array} codePoints The array of numeric code points.\x0d\n * @returns {String} The new Unicode string (UCS-2).\x0d\n */\x0d\nconst ucs2encode = array => String.fromCodePoint(...array);\x0d\n\x0d\n/**\x0d\n * Converts a basic code point into a digit/integer.\x0d\n * @see `digitToBasic()`\x0d\n * @private\x0d\n * @param {Number} codePoint The basic numeric code point value.\x0d\n * @returns {Number} The numeric value of a basic code point (for use in\x0d\n * representing integers) in the range `0` to `base - 1`\x2C or `base` if\x0d\n * the code point does not represent a value.\x0d\n */\x0d\nconst basicToDigit = function(codePoint) {\x0d\n\x09if (codePoint - 0x30 < 0x0A) {\x0d\n\x09\x09return codePoint - 0x16;\x0d\n\x09}\x0d\n\x09if (codePoint - 0x41 < 0x1A) {\x0d\n\x09\x09return codePoint - 0x41;\x0d\n\x09}\x0d\n\x09if (codePoint - 0x61 < 0x1A) {\x0d\n\x09\x09return codePoint - 0x61;\x0d\n\x09}\x0d\n\x09return base;\x0d\n};\x0d\n\x0d\n/**\x0d\n * Converts a digit/integer into a basic code point.\x0d\n * @see `basicToDigit()`\x0d\n * @private\x0d\n * @param {Number} digit The numeric value of a basic code point.\x0d\n * @returns {Number} The basic code point whose value (when used for\x0d\n * representing integers) is `digit`\x2C which needs to be in the range\x0d\n * `0` to `base - 1`. If `flag` is non-zero\x2C the uppercase form is\x0d\n * used; else\x2C the lowercase form is used. The behavior is undefined\x0d\n * if `flag` is non-zero and `digit` has no uppercase form.\x0d\n */\x0d\nconst digitToBasic = function(digit\x2C flag) {\x0d\n\x09//  0..25 map to ASCII a..z or A..Z\x0d\n\x09// 26..35 map to ASCII 0..9\x0d\n\x09return digit + 22 + 75 * (digit < 26) - ((flag != 0) << 5);\x0d\n};\x0d\n\x0d\n/**\x0d\n * Bias adaptation function as per section 3.4 of RFC 3492.\x0d\n * https://tools.ietf.org/html/rfc3492#section-3.4\x0d\n * @private\x0d\n */\x0d\nconst adapt = function(delta\x2C numPoints\x2C firstTime) {\x0d\n\x09let k = 0;\x0d\n\x09delta = firstTime ? floor(delta / damp) : delta >> 1;\x0d\n\x09delta += floor(delta / numPoints);\x0d\n\x09for (/* no initialization */; delta > baseMinusTMin * tMax >> 1; k += base) {\x0d\n\x09\x09delta = floor(delta / baseMinusTMin);\x0d\n\x09}\x0d\n\x09return floor(k + (baseMinusTMin + 1) * delta / (delta + skew));\x0d\n};\x0d\n\x0d\n/**\x0d\n * Converts a Punycode string of ASCII-only symbols to a string of Unicode\x0d\n * symbols.\x0d\n * @memberOf punycode\x0d\n * @param {String} input The Punycode string of ASCII-only symbols.\x0d\n * @returns {String} The resulting string of Unicode symbols.\x0d\n */\x0d\nconst decode = function(input) {\x0d\n\x09// Don't use UCS-2.\x0d\n\x09const output = [];\x0d\n\x09const inputLength = input.length;\x0d\n\x09let i = 0;\x0d\n\x09let n = initialN;\x0d\n\x09let bias = initialBias;\x0d\n\x0d\n\x09// Handle the basic code points: let `basic` be the number of input code\x0d\n\x09// points before the last delimiter\x2C or `0` if there is none\x2C then copy\x0d\n\x09// the first basic code points to the output.\x0d\n\x0d\n\x09let basic = input.lastIndexOf(delimiter);\x0d\n\x09if (basic < 0) {\x0d\n\x09\x09basic = 0;\x0d\n\x09}\x0d\n\x0d\n\x09for (let j = 0; j < basic; ++j) {\x0d\n\x09\x09// if it's not a basic code point\x0d\n\x09\x09if (input.charCodeAt(j) >= 0x80) {\x0d\n\x09\x09\x09error('not-basic');\x0d\n\x09\x09}\x0d\n\x09\x09output.push(input.charCodeAt(j));\x0d\n\x09}\x0d\n\x0d\n\x09// Main decoding loop: start just after the last delimiter if any basic code\x0d\n\x09// points were copied; start at the beginning otherwise.\x0d\n\x0d\n\x09for (let index = basic > 0 ? basic + 1 : 0; index < inputLength; /* no final expression */) {\x0d\n\x0d\n\x09\x09// `index` is the index of the next character to be consumed.\x0d\n\x09\x09// Decode a generalized variable-length integer into `delta`\x2C\x0d\n\x09\x09// which gets added to `i`. The overflow checking is easier\x0d\n\x09\x09// if we increase `i` as we go\x2C then subtract off its starting\x0d\n\x09\x09// value at the end to obtain `delta`.\x0d\n\x09\x09let oldi = i;\x0d\n\x09\x09for (let w = 1\x2C k = base; /* no condition */; k += base) {\x0d\n\x0d\n\x09\x09\x09if (index >= inputLength) {\x0d\n\x09\x09\x09\x09error('invalid-input');\x0d\n\x09\x09\x09}\x0d\n\x0d\n\x09\x09\x09const digit = basicToDigit(input.charCodeAt(index++));\x0d\n\x0d\n\x09\x09\x09if (digit >= base || digit > floor((maxInt - i) / w)) {\x0d\n\x09\x09\x09\x09error('overflow');\x0d\n\x09\x09\x09}\x0d\n\x0d\n\x09\x09\x09i += digit * w;\x0d\n\x09\x09\x09const t = k <= bias ? tMin : (k >= bias + tMax ? tMax : k - bias);\x0d\n\x0d\n\x09\x09\x09if (digit < t) {\x0d\n\x09\x09\x09\x09break;\x0d\n\x09\x09\x09}\x0d\n\x0d\n\x09\x09\x09const baseMinusT = base - t;\x0d\n\x09\x09\x09if (w > floor(maxInt / baseMinusT)) {\x0d\n\x09\x09\x09\x09err