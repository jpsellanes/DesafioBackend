script-source,509,C:\\Users\\sella\\Desktop\\Programacion\\CoderHouse\\Backend\\Desafio14\\node_modules\\winston\\lib\\winston\\common.js,/**\x0d\n * common.js: Internal helper and utility functions for winston.\x0d\n *\x0d\n * (C) 2010 Charlie Robbins\x0d\n * MIT LICENCE\x0d\n */\x0d\n\x0d\n'use strict';\x0d\n\x0d\nconst { format } = require('util');\x0d\n\x0d\n/**\x0d\n * Set of simple deprecation notices and a way to expose them for a set of\x0d\n * properties.\x0d\n * @type {Object}\x0d\n * @private\x0d\n */\x0d\nexports.warn = {\x0d\n  deprecated(prop) {\x0d\n    return () => {\x0d\n      throw new Error(format('{ %s } was removed in winston@3.0.0.'\x2C prop));\x0d\n    };\x0d\n  }\x2C\x0d\n  useFormat(prop) {\x0d\n    return () => {\x0d\n      throw new Error([\x0d\n        format('{ %s } was removed in winston@3.0.0.'\x2C prop)\x2C\x0d\n        'Use a custom winston.format = winston.format(function) instead.'\x0d\n      ].join('\\n'));\x0d\n    };\x0d\n  }\x2C\x0d\n  forFunctions(obj\x2C type\x2C props) {\x0d\n    props.forEach(prop => {\x0d\n      obj[prop] = exports.warn[type](prop);\x0d\n    });\x0d\n  }\x2C\x0d\n  moved(obj\x2C movedTo\x2C prop) {\x0d\n    function movedNotice() {\x0d\n      return () => {\x0d\n        throw new Error([\x0d\n          format('winston.%s was moved in winston@3.0.0.'\x2C prop)\x2C\x0d\n          format('Use a winston.%s instead.'\x2C movedTo)\x0d\n        ].join('\\n'));\x0d\n      };\x0d\n    }\x0d\n\x0d\n    Object.defineProperty(obj\x2C prop\x2C {\x0d\n      get: movedNotice\x2C\x0d\n      set: movedNotice\x0d\n    });\x0d\n  }\x2C\x0d\n  forProperties(obj\x2C type\x2C props) {\x0d\n    props.forEach(prop => {\x0d\n      const notice = exports.warn[type](prop);\x0d\n      Object.defineProperty(obj\x2C prop\x2C {\x0d\n        get: notice\x2C\x0d\n        set: notice\x0d\n      });\x0d\n    });\x0d\n  }\x0d\n};\x0d\n
