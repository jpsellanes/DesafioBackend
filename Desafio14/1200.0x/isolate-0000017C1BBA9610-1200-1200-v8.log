d\n    // Copy new buffer not to be modified by user.\x0d\n    out.ALPNProtocols = Buffer.from(protocols);\x0d\n  }\x0d\n};\x0d\n\x0d\nfunction unfqdn(host) {\x0d\n  return StringPrototypeReplace(host\x2C /[.]$/\x2C '');\x0d\n}\x0d\n\x0d\n// String#toLowerCase() is locale-sensitive so we use\x0d\n// a conservative version that only lowercases A-Z.\x0d\nfunction toLowerCase(c) {\x0d\n  return StringFromCharCode(32 + StringPrototypeCharCodeAt(c\x2C 0));\x0d\n}\x0d\n\x0d\nfunction splitHost(host) {\x0d\n  return StringPrototypeSplit(\x0d\n    StringPrototypeReplace(unfqdn(host)\x2C /[A-Z]/g\x2C toLowerCase)\x2C\x0d\n    '.'\x0d\n  );\x0d\n}\x0d\n\x0d\nfunction check(hostParts\x2C pattern\x2C wildcards) {\x0d\n  // Empty strings\x2C null\x2C undefined\x2C etc. never match.\x0d\n  if (!pattern)\x0d\n    return false;\x0d\n\x0d\n  const patternParts = splitHost(pattern);\x0d\n\x0d\n  if (hostParts.length !== patternParts.length)\x0d\n    return false;\x0d\n\x0d\n  // Pattern has empty components\x2C e.g. "bad..example.com".\x0d\n  if (ArrayPrototypeIncludes(patternParts\x2C ''))\x0d\n    return false;\x0d\n\x0d\n  // RFC 6125 allows IDNA U-labels (Unicode) in names but we have no\x0d\n  // good way to detect their encoding or normalize them so we simply\x0d\n  // reject them.  Control characters and blanks are rejected as well\x0d\n  // because nothing good can come from accepting them.\x0d\n  const isBad = (s) => RegExpPrototypeTest(/[^\\u0021-\\u007F]/u\x2C s);\x0d\n  if (ArrayPrototypeSome(patternParts\x2C isBad))\x0d\n    return false;\x0d\n\x0d\n  // Check host parts from right to left first.\x0d\n  for (let i = hostParts.length - 1; i > 0; i -= 1) {\x0d\n    if (hostParts[i] !== patternParts[i])\x0d\n      return false;\x0d\n  }\x0d\n\x0d\n  const hostSubdomain = hostParts[0];\x0d\n  const patternSubdomain = patternParts[0];\x0d\n  const patternSubdomainParts = StringPrototypeSplit(patternSubdomain\x2C '*');\x0d\n\x0d\n  // Short-circuit when the subdomain does not contain a wildcard.\x0d\n  // RFC 6125 does not allow wildcard substitution for components\x0d\n  // containing IDNA A-labels (Punycode) so match those verbatim.\x0d\n  if (patternSubdomainParts.length === 1 ||\x0d\n      StringPrototypeIncludes(patternSubdomain\x2C 'xn--'))\x0d\n    return hostSubdomain === patternSubdomain;\x0d\n\x0d\n  if (!wildcards)\x0d\n    return false;\x0d\n\x0d\n  // More than one wildcard is always wrong.\x0d\n  if (patternSubdomainParts.length > 2)\x0d\n    return false;\x0d\n\x0d\n  // *.tld wildcards are not allowed.\x0d\n  if (patternParts.length <= 2)\x0d\n    return false;\x0d\n\x0d\n  const { 0: prefix\x2C 1: suffix } = patternSubdomainParts;\x0d\n\x0d\n  if (prefix.length + suffix.length > hostSubdomain.length)\x0d\n    return false;\x0d\n\x0d\n  if (!StringPrototypeStartsWith(hostSubdomain\x2C prefix))\x0d\n    return false;\x0d\n\x0d\n  if (!StringPrototypeEndsWith(hostSubdomain\x2C suffix))\x0d\n    return false;\x0d\n\x0d\n  return true;\x0d\n}\x0d\n\x0d\n// This pattern is used to determine the length of escaped sequences within\x0d\n// the subject alt names string. It allows any valid JSON string literal.\x0d\n// This MUST match the JSON specification (ECMA-404 / RFC8259) exactly.\x0d\nconst jsonStringPattern =\x0d\n  // eslint-disable-next-line no-control-regex\x0d\n  /^"(?:[^"\\\\\\u0000-\\u001f]|\\\\(?:["\\\\/bfnrt]|u[0-9a-fA-F]{4}))*"/;\x0d\n\x0d\nfunction splitEscapedAltNames(altNames) {\x0d\n  const result = [];\x0d\n  let currentToken = '';\x0d\n  let offset = 0;\x0d\n  while (offset !== altNames.length) {\x0d\n    const nextSep = StringPrototypeIndexOf(altNames\x2C '\x2C '\x2C offset);\x0d\n    const nextQuote = StringPrototypeIndexOf(altNames\x2C '"'\x2C offset);\x0d\n    if (nextQuote !== -1 && (nextSep === -1 || nextQuote < nextSep)) {\x0d\n      // There is a quote character and there is no separator before the quote.\x0d\n      currentToken += StringPrototypeSubstring(altNames\x2C offset\x2C nextQuote);\x0d\n      const match = RegExpPrototypeExec(\x0d\n        jsonStringPattern\x2C StringPrototypeSubstring(altNames\x2C nextQuote));\x0d\n      if (!match) {\x0d\n        throw new ERR_TLS_CERT_ALTNAME_FORMAT();\x0d\n      }\x0d\n      currentToken += JSONParse(match[0]);\x0d\n      offset = nextQuote + match[0].length;\x0d\n    } else if (nextSep !== -1) {\x0d\n      // There is a separator and no quote before it.\x0d\n      currentToken += StringPrototypeSubstring(altNames\x2C offset\x2C nextSep);\x0d\n      ArrayPrototypePush(result\x2C currentToken);\x0d\n      currentToken = '';\x0d\n      offset = nextSep + 2;\x0d\n    } else {\x0d\n      currentToken += StringPrototypeSubstring(altNames\x2C offset);\x0d\n      offset = altNames.length;\x0d\n    }\x0d\n  }\x0d\n  ArrayPrototypePush(result\x2C currentToken);\x0d\n  return result;\x0d\n}\x0d\n\x0d\nexports.checkServerIdentity = function checkServerIdentity(hostname\x2C cert) {\x0d\n  const subject = cert.subject;\x0d\n  const altNames = cert.subjectaltname;\x0d\n  const dnsNames = [];\x0d\n  const uriNames = [];\x0d\n  const ips = [];\x0d\n\x0d\n  hostname = '' + hostname;\x0d\n\x0d\n  if (altNames) {\x0d\n    const splitAltNames = StringPrototypeIncludes(altNames\x2C '"') ?\x0d\n      splitEscapedAltNames(altNames) :\x0d\n      StringPrototypeSplit(altNames\x2C '\x2C ');\x0d\n    ArrayPrototypeForEach(splitAltNames\x2C (name) => {\x0d\n      if (StringPrototypeStartsWith(name\x2C 'DNS:')) {\x0d\n        ArrayPrototypePush(dnsNames\x2C StringPrototypeSlice(name\x2C 4));\x0d\n      } else if (process.REVERT_CVE_2021_44531 &&\x0d\n                 StringPrototypeStartsWith(name\x2C 'URI:')) {\x0d\n        const uri = new URL(StringPrototypeSlice(name\x2C 4));\x0d\n\x0d\n        // TODO(bnoordhuis) Also use scheme.\x0d\n        ArrayPrototypePush(uriNames\x2C uri.hostname);\x0d\n      } else if (StringPrototypeStartsWith(name\x2C 'IP Address:')) {\x0d\n        ArrayPrototypePush(ips\x2C canonicalizeIP(StringPrototypeSlice(name\x2C 11)));\x0d\n      }\x0d\n    });\x0d\n  }\x0d\n\x0d\n  let valid = false;\x0d\n  let reason = 'Unknown reason';\x0d\n\x0d\n  const hasAltNames =\x0d\n    dnsNames.length > 0 || ips.length > 0 || uriNames.length > 0;\x0d\n\x0d\n  hostname = unfqdn(hostname);  // Remove trailing dot for error messages.\x0d\n\x0d\n  if (net.isIP(hostname)) {\x0d\n    valid = ArrayPrototypeIncludes(ips\x2C canonicalizeIP(hostname));\x0d\n    if (!valid)\x0d\n      reason = `IP: ${hostname} is not in the cert's list: ` +\x0d\n               ArrayPrototypeJoin(ips\x2C '\x2C ');\x0d\n    // TODO(bnoordhuis) Also check URI SANs that are IP addresses.\x0d\n  } else if ((process.REVERT_CVE_2021_44531 && (hasAltNames || subject)) ||\x0d\n             (dnsNames.length > 0 || subject?.CN)) {\x0d\n    const hostParts = splitHost(hostname);\x0d\n    const wildcard = (pattern) => check(hostParts\x2C pattern\x2C true);\x0d\n\x0d\n    if ((process.REVERT_CVE_2021_44531 && hasAltNames) ||\x0d\n        (dnsNames.length > 0)) {\x0d\n      const noWildcard = (pattern) => check(hostParts\x2C pattern\x2C false);\x0d\n      valid = ArrayPrototypeSome(dnsNames\x2C wildcard) ||\x0d\n              ArrayPrototypeSome(uriNames\x2C noWildcard);\x0d\n      if (!valid)\x0d\n        reason =\x0d\n          `Host: ${hostname}. is not in the cert's altnames: ${altNames}`;\x0d\n    } else {\x0d\n      // Match against Common Name only if no supported identifiers exist.\x0d\n      const cn = subject.CN;\x0d\n\x0d\n      if (ArrayIsArray(cn))\x0d\n        valid = ArrayPrototypeSome(cn\x2C wildcard);\x0d\n      else if (cn)\x0d\n        valid = wildcard(cn);\x0d\n\x0d\n      if (!valid)\x0d\n        reason = `Host: ${hostname}. is not cert's CN: ${cn}`;\x0d\n    }\x0d\n  } else {\x0d\n    reason = 'Cert does not contain a DNS name';\x0d\n  }\x0d\n\x0d\n  if (!valid) {\x0d\n    return new ERR_TLS_CERT_ALTNAME_INVALID(reason\x2C hostname\x2C cert);\x0d\n  }\x0d\n};\x0d\n\x0d\nexports.createSecureContext = _tls_common.createSecureContext;\x0d\nexports.SecureContext = _tls_common.SecureContext;\x0d\nexports.TLSSocket = _tls_wrap.TLSSocket;\x0d\nexports.Server = _tls_wrap.Server;\x0d\nexports.createServer = _tls_wrap.createServer;\x0d\nexports.connect = _tls_wrap.connect;\x0d\n\x0d\nexports.parseCertString = internalUtil.deprecate(\x0d\n  parseCertString\x2C\x0d\n  'tls.parseCertString() is deprecated. ' +\x0d\n  'Please use querystring.parse() instead.'\x2C\x0d\n  'DEP0076');\x0d\n\x0d\nexports.createSecurePair = internalUtil.deprecate(\x0d\n  createSecurePair\x2C\x0d\n  'tls.createSecurePair() is deprecated. Please use ' +\x0d\n  'tls.TLSSocket instead.'\x2C 'DEP0064');\x0d\n
