sfies these scenarios.\n *\n * Examples:\n *\n *     passport.unuse('legacy-api');\n *\n * @param {String} name\n * @return {Authenticator} for chaining\n * @api public\n */\nAuthenticator.prototype.unuse = function(name) {\n  delete this._strategies[name];\n  return this;\n};\n\n/**\n * Setup Passport to be used under framework.\n *\n * By default\x2C Passport exposes middleware that operate using Connect-style\n * middleware using a `fn(req\x2C res\x2C next)` signature.  Other popular frameworks\n * have different expectations\x2C and this function allows Passport to be adapted\n * to operate within such environments.\n *\n * If you are using a Connect-compatible framework\x2C including Express\x2C there is\n * no need to invoke this function.\n *\n * Examples:\n *\n *     passport.framework(require('hapi-passport')());\n *\n * @param {Object} name\n * @return {Authenticator} for chaining\n * @api public\n */\nAuthenticator.prototype.framework = function(fw) {\n  this._framework = fw;\n  return this;\n};\n\n/**\n * Passport's primary initialization middleware.\n *\n * This middleware must be in use by the Connect/Express application for\n * Passport to operate.\n *\n * Options:\n *   - `userProperty`  Property to set on `req` upon login\x2C defaults to _user_\n *\n * Examples:\n *\n *     app.use(passport.initialize());\n *\n *     app.use(passport.initialize({ userProperty: 'currentUser' }));\n *\n * @param {Object} options\n * @return {Function} middleware\n * @api public\n */\nAuthenticator.prototype.initialize = function(options) {\n  options = options || {};\n  return this._framework.initialize(this\x2C options);\n};\n\n/**\n * Middleware that will authenticate a request using the given `strategy` name\x2C\n * with optional `options` and `callback`.\n *\n * Examples:\n *\n *     passport.authenticate('local'\x2C { successRedirect: '/'\x2C failureRedirect: '/login' })(req\x2C res);\n *\n *     passport.authenticate('local'\x2C function(err\x2C user) {\n *       if (!user) { return res.redirect('/login'); }\n *       res.end('Authenticated!');\n *     })(req\x2C res);\n *\n *     passport.authenticate('basic'\x2C { session: false })(req\x2C res);\n *\n *     app.get('/auth/twitter'\x2C passport.authenticate('twitter')\x2C function(req\x2C res) {\n *       // request will be redirected to Twitter\n *     });\n *     app.get('/auth/twitter/callback'\x2C passport.authenticate('twitter')\x2C function(req\x2C res) {\n *       res.json(req.user);\n *     });\n *\n * @param {String} strategy\n * @param {Object} options\n * @param {Function} callback\n * @return {Function} middleware\n * @api public\n */\nAuthenticator.prototype.authenticate = function(strategy\x2C options\x2C callback) {\n  return this._framework.authenticate(this\x2C strategy\x2C options\x2C callback);\n};\n\n/**\n * Middleware that will authorize a third-party account using the given\n * `strategy` name\x2C with optional `options`.\n *\n * If authorization is successful\x2C the result provided by the strategy's verify\n * callback will be assigned to `req.account`.  The existing login session and\n * `req.user` will be unaffected.\n *\n * This function is particularly useful when connecting third-party accounts\n * to the local account of a user that is currently authenticated.\n *\n * Examples:\n *\n *    passport.authorize('twitter-authz'\x2C { failureRedirect: '/account' });\n *\n * @param {String} strategy\n * @param {Object} options\n * @return {Function} middleware\n * @api public\n */\nAuthenticator.prototype.authorize = function(strategy\x2C options\x2C callback) {\n  options = options || {};\n  options.assignProperty = 'account';\n  \n  var fn = this._framework.authorize || this._framework.authenticate;\n  return fn(this\x2C strategy\x2C options\x2C callback);\n};\n\n/**\n * Middleware that will restore login state from a session.\n *\n * Web applications typically use sessions to maintain login state between\n * requests.  For example\x2C a user will