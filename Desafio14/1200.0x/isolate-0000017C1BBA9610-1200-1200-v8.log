rn;\x0d\n    const req = this[kCurrentShutdownRequest];\x0d\n    this[kCurrentShutdownRequest] = null;\x0d\n    handle.finishShutdown(req\x2C errCode);\x0d\n  }\x0d\n\x0d\n  doWrite(req\x2C bufs) {\x0d\n    assert(this[kCurrentWriteRequest] === null);\x0d\n    assert(this[kCurrentShutdownRequest] === null);\x0d\n\x0d\n    const handle = this._handle;\x0d\n    const self = this;\x0d\n\x0d\n    let pending = bufs.length;\x0d\n\x0d\n    this.stream.cork();\x0d\n    // Use `var` over `let` for performance optimization.\x0d\n    for (var i = 0; i < bufs.length; ++i)\x0d\n      this.stream.write(bufs[i]\x2C done);\x0d\n    this.stream.uncork();\x0d\n\x0d\n    // Only set the request here\x2C because the `write()` calls could throw.\x0d\n    this[kCurrentWriteRequest] = req;\x0d\n\x0d\n    function done(err) {\x0d\n      if (!err && --pending !== 0)\x0d\n        return;\x0d\n\x0d\n      // Ensure that this is called once in case of error\x0d\n      pending = 0;\x0d\n\x0d\n      let errCode = 0;\x0d\n      if (err) {\x0d\n        errCode = uv[`UV_${err.code}`] || uv.UV_EPIPE;\x0d\n      }\x0d\n\x0d\n      // Ensure that write was dispatched\x0d\n      setImmediate(() => {\x0d\n        self.finishWrite(handle\x2C errCode);\x0d\n      });\x0d\n    }\x0d\n\x0d\n    return 0;\x0d\n  }\x0d\n\x0d\n  // handle === this._handle except when called from doClose().\x0d\n  finishWrite(handle\x2C errCode) {\x0d\n    // The write request might already have been cancelled.\x0d\n    if (this[kCurrentWriteRequest] === null)\x0d\n      return;\x0d\n    const req = this[kCurrentWriteRequest];\x0d\n    this[kCurrentWriteRequest] = null;\x0d\n\x0d\n    handle.finishWrite(req\x2C errCode);\x0d\n    if (this[kPendingShutdownRequest]) {\x0d\n      const req = this[kPendingShutdownRequest];\x0d\n      this[kPendingShutdownRequest] = null;\x0d\n      this.doShutdown(req);\x0d\n    }\x0d\n  }\x0d\n\x0d\n  doClose(cb) {\x0d\n    const handle = this._handle;\x0d\n\x0d\n    // When sockets of the "net" module destroyed\x2C they will call\x0d\n    // `this._handle.close()` which will also emit EOF if not emitted before.\x0d\n    // This feature makes sockets on the other side emit "end" and "close"\x0d\n    // even though we haven't called `end()`. As `stream` are likely to be\x0d\n    // instances of `net.Socket`\x2C calling `stream.destroy()` manually will\x0d\n    // avoid issues that don't properly close wrapped connections.\x0d\n    this.stream.destroy();\x0d\n\x0d\n    setImmediate(() => {\x0d\n      // Should be already set by net.js\x0d\n      assert(this._handle === null);\x0d\n\x0d\n      this.finishWrite(handle\x2C uv.UV_ECANCELED);\x0d\n      this.finishShutdown(handle\x2C uv.UV_ECANCELED);\x0d\n\x0d\n      cb();\x0d\n    });\x0d\n  }\x0d\n}\x0d\n\x0d\nmodule.exports = JSStreamSocket;\x0d\n
