script-source,488,C:\\Users\\sella\\Desktop\\Programacion\\CoderHouse\\Backend\\Desafio14\\node_modules\\winston\\lib\\winston.js,/**\x0d\n * winston.js: Top-level include defining Winston.\x0d\n *\x0d\n * (C) 2010 Charlie Robbins\x0d\n * MIT LICENCE\x0d\n */\x0d\n\x0d\n'use strict';\x0d\n\x0d\nconst logform = require('logform');\x0d\nconst { warn } = require('./winston/common');\x0d\n\x0d\n/**\x0d\n * Expose version. Use `require` method for `webpack` support.\x0d\n * @type {string}\x0d\n */\x0d\nexports.version = require('../package.json').version;\x0d\n/**\x0d\n * Include transports defined by default by winston\x0d\n * @type {Array}\x0d\n */\x0d\nexports.transports = require('./winston/transports');\x0d\n/**\x0d\n * Expose utility methods\x0d\n * @type {Object}\x0d\n */\x0d\nexports.config = require('./winston/config');\x0d\n/**\x0d\n * Hoist format-related functionality from logform.\x0d\n * @type {Object}\x0d\n */\x0d\nexports.addColors = logform.levels;\x0d\n/**\x0d\n * Hoist format-related functionality from logform.\x0d\n * @type {Object}\x0d\n */\x0d\nexports.format = logform.format;\x0d\n/**\x0d\n * Expose core Logging-related prototypes.\x0d\n * @type {function}\x0d\n */\x0d\nexports.createLogger = require('./winston/create-logger');\x0d\n/**\x0d\n * Expose core Logging-related prototypes.\x0d\n * @type {Object}\x0d\n */\x0d\nexports.ExceptionHandler = require('./winston/exception-handler');\x0d\n/**\x0d\n * Expose core Logging-related prototypes.\x0d\n * @type {Object}\x0d\n */\x0d\nexports.RejectionHandler = require('./winston/rejection-handler');\x0d\n/**\x0d\n * Expose core Logging-related prototypes.\x0d\n * @type {Container}\x0d\n */\x0d\nexports.Container = require('./winston/container');\x0d\n/**\x0d\n * Expose core Logging-related prototypes.\x0d\n * @type {Object}\x0d\n */\x0d\nexports.Transport = require('winston-transport');\x0d\n/**\x0d\n * We create and expose a default `Container` to `winston.loggers` so that the\x0d\n * programmer may manage multiple `winston.Logger` instances without any\x0d\n * additional overhead.\x0d\n * @example\x0d\n *   // some-file1.js\x0d\n *   const logger = require('winston').loggers.get('something');\x0d\n *\x0d\n *   // some-file2.js\x0d\n *   const logger = require('winston').loggers.get('something');\x0d\n */\x0d\nexports.loggers = new exports.Container();\x0d\n\x0d\n/**\x0d\n * We create and expose a 'defaultLogger' so that the programmer may do the\x0d\n * following without the need to create an instance of winston.Logger directly:\x0d\n * @example\x0d\n *   const winston = require('winston');\x0d\n *   winston.log('info'\x2C 'some message');\x0d\n *   winston.error('some error');\x0d\n */\x0d\nconst defaultLogger = exports.createLogger();\x0d\n\x0d\n// Pass through the target methods onto `winston.\x0d\nObject.keys(exports.config.npm.levels)\x0d\n  .concat([\x0d\n    'log'\x2C\x0d\n    'query'\x2C\x0d\n    'stream'\x2C\x0d\n    'add'\x2C\x0d\n    'remove'\x2C\x0d\n    'clear'\x2C\x0d\n    'profile'\x2C\x0d\n    'startTimer'\x2C\x0d\n    'handleExceptions'\x2C\x0d\n    'unhandleExceptions'\x2C\x0d\n    'handleRejections'\x2C\x0d\n    'unhandleRejections'\x2C\x0d\n    'configure'\x2C\x0d\n    'child'\x0d\n  ])\x0d\n  .forEach(\x0d\n    method => (exports[method] = (...args) => defaultLogger[method](...args))\x0d\n  );\x0d\n\x0d\n/**\x0d\n * Define getter / setter for the default logger level which need to be exposed\x0d\n * by winston.\x0d\n * @type {string}\x0d\n */\x0d\nObject.defineProperty(exports\x2C 'level'\x2C {\x0d\n  get() {\x0d\n    return defaultLogger.level;\x0d\n  }\x2C\x0d\n  set(val) {\x0d\n    defaultLogger.level = val;\x0d\n  }\x0d\n});\x0d\n\x0d\n/**\x0d\n * Define getter for `exceptions` which replaces `handleExceptions` and\x0d\n * `unhandleExceptions`.\x0d\n * @type {Object}\x0d\n */\x0d\nObject.defineProperty(exports\x2C 'exceptions'\x2C {\x0d\n  get() {\x0d\n    return defaultLogger.exceptions;\x0d\n  }\x0d\n});\x0d\n\x0d\n/**\x0d\n * Define getters / setters for appropriate properties of the default logger\x0d\n * which need to be exposed by winston.\x0d\n * @type {Logger}\x0d\n */\x0d\n['exitOnError'].forEach(prop => {\x0d\n  Object.defineProperty(exports\x2C prop\x2C {\x0d\n    get() {\x0d\n      return defaultLogger[prop];\x0d\n    }\x2C\x0d\n    set(val) {\x0d\n      defaultLogger[prop] = val;\x0d\n    }\x0d\n  });\x0d\n});\x0d\n\x0d\n/**\x0d\n * The default transports and exceptionHandlers for the default winston logger.\x0d\n * @type {Object}\x0d\n */\x0d\nObject.defineProperty(exports\x2C 'default'\x2C {\x0d\n  get() {\x0d\n    return {\x0d\n      exceptionHandlers: defaultLogger.exceptionHandlers\x2C\x0d\n      rejectionHandlers: defaultLogger.rejectionHandlers\x2C\x0d\n      transports: defaultLogger.transports\x0d\n    };\x0d\n  }\x0d\n});\x0d\n\x0d\n// Have friendlier breakage notices for properties that were exposed by default\x0d\n// on winston < 3.0.\x0d\nwarn.deprecated(exports\x2C 'setLevels');\x0d\nwarn.forFunctions(exports\x2C 'useFormat'\x2C ['cli']);\x0d\nwarn.forProperties(exports\x2C 'useFormat'\x2C ['padLevels'\x2C 'stripColors']);\x0d\nwarn.forFunctions(exports\x2C 'deprecated'\x2C [\x0d\n  'addRewriter'\x2C\x0d\n  'addFilter'\x2C\x0d\n  'clone'\x2C\x0d\n  'extend'\x0d\n]);\x0d\nwarn.forProperties(exports\x2C 'deprecated'\x2C ['emitErrs'\x2C 'levelLength']);\x0d\n// Throw a useful error when users attempt to run `new winston.Logger`.\x0d\nwarn.moved(exports\x2C 'createLogger'\x2C 'Logger');\x0d\n
