script-source,513,C:\\Users\\sella\\Desktop\\Programacion\\CoderHouse\\Backend\\Desafio14\\node_modules\\winston\\lib\\winston\\logger.js,/**\x0d\n * logger.js: TODO: add file header description.\x0d\n *\x0d\n * (C) 2010 Charlie Robbins\x0d\n * MIT LICENCE\x0d\n */\x0d\n\x0d\n'use strict';\x0d\n\x0d\nconst { Stream\x2C Transform } = require('readable-stream');\x0d\nconst asyncForEach = require('async/forEach');\x0d\nconst { LEVEL\x2C SPLAT } = require('triple-beam');\x0d\nconst isStream = require('is-stream');\x0d\nconst ExceptionHandler = require('./exception-handler');\x0d\nconst RejectionHandler = require('./rejection-handler');\x0d\nconst LegacyTransportStream = require('winston-transport/legacy');\x0d\nconst Profiler = require('./profiler');\x0d\nconst { warn } = require('./common');\x0d\nconst config = require('./config');\x0d\n\x0d\n/**\x0d\n * Captures the number of format (i.e. %s strings) in a given string.\x0d\n * Based on `util.format`\x2C see Node.js source:\x0d\n * https://github.com/nodejs/node/blob/b1c8f15c5f169e021f7c46eb7b219de95fe97603/lib/util.js#L201-L230\x0d\n * @type {RegExp}\x0d\n */\x0d\nconst formatRegExp = /%[scdjifoO%]/g;\x0d\n\x0d\n/**\x0d\n * TODO: add class description.\x0d\n * @type {Logger}\x0d\n * @extends {Transform}\x0d\n */\x0d\nclass Logger extends Transform {\x0d\n  /**\x0d\n   * Constructor function for the Logger object responsible for persisting log\x0d\n   * messages and metadata to one or more transports.\x0d\n   * @param {!Object} options - foo\x0d\n   */\x0d\n  constructor(options) {\x0d\n    super({ objectMode: true });\x0d\n    this.configure(options);\x0d\n  }\x0d\n\x0d\n  child(defaultRequestMetadata) {\x0d\n    const logger = this;\x0d\n    return Object.create(logger\x2C {\x0d\n      write: {\x0d\n        value: function (info) {\x0d\n          const infoClone = Object.assign(\x0d\n            {}\x2C\x0d\n            defaultRequestMetadata\x2C\x0d\n            info\x0d\n          );\x0d\n\x0d\n          // Object.assign doesn't copy inherited Error\x0d\n          // properties so we have to do that explicitly\x0d\n          //\x0d\n          // Remark (indexzero): we should remove this\x0d\n          // since the errors format will handle this case.\x0d\n          //\x0d\n          if (info instanceof Error) {\x0d\n            infoClone.stack = info.stack;\x0d\n            infoClone.message = info.message;\x0d\n          }\x0d\n\x0d\n          logger.write(infoClone);\x0d\n        }\x0d\n      }\x0d\n    });\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * This will wholesale reconfigure this instance by:\x0d\n   * 1. Resetting all transports. Older transports will be removed implicitly.\x0d\n   * 2. Set all other options including levels\x2C colors\x2C rewriters\x2C filters\x2C\x0d\n   *    exceptionHandlers\x2C etc.\x0d\n   * @param {!Object} options - TODO: add param description.\x0d\n   * @returns {undefined}\x0d\n   */\x0d\n  configure({\x0d\n    silent\x2C\x0d\n    format\x2C\x0d\n    defaultMeta\x2C\x0d\n    levels\x2C\x0d\n    level = 'info'\x2C\x0d\n    exitOnError = true\x2C\x0d\n    transports\x2C\x0d\n    colors\x2C\x0d\n    emitErrs\x2C\x0d\n    formatters\x2C\x0d\n    padLevels\x2C\x0d\n    rewriters\x2C\x0d\n    stripColors\x2C\x0d\n    exceptionHandlers\x2C\x0d\n    rejectionHandlers\x0d\n  } = {}) {\x0d\n    // Reset transports if we already have them\x0d\n    if (this.transports.length) {\x0d\n      this.clear();\x0d\n    }\x0d\n\x0d\n    this.silent = silent;\x0d\n    this.format = format || this.format || require('logform/json')();\x0d\n\x0d\n    this.defaultMeta = defaultMeta || null;\x0d\n    // Hoist other options onto this instance.\x0d\n    this.levels = levels || this.levels || config.npm.levels;\x0d\n    this.level = level;\x0d\n    if (this.exceptions) {\x0d\n      this.exceptions.unhandle();\x0d\n    }\x0d\n    if (this.rejections) {\x0d\n      this.rejections.unhandle();\x0d\n    }\x0d\n    this.exceptions = new ExceptionHandler(this);\x0d\n    this.rejections = new RejectionHandler(this);\x0d\n    this.profilers = {};\x0d\n    this.exitOnError = exitOnError;\x0d\n\x0d\n    // Add all transports we have been provided.\x0d\n    if (transports) {\x0d\n      transports = Array.isArray(transports) ? transports : [transports];\x0d\n      transports.forEach(transport => this.add(transport));\x0d\n    }\x0d\n\x0d\n    if (\x0d\n      colors ||\x0d\n      emitErrs ||\x0d\n      formatters ||\x0d\n      padLevels ||\x0d\n      rewriters ||\x0d\n      stripColors\x0d\n    ) {\x0d\n      throw new Error(\x0d\n        [\x0d\n          '{ colors\x2C emitErrs\x2C formatters\x2C padLevels\x2C rewriters\x2C stripColors } were removed in winston@3.0.0.'\x2C\x0d\n          'Use a custom winston.format(function) instead.'\x2C\x0d\n          'See: https://github.com/winstonjs/winston/tree/master/UPGRADE-3.0.md'\x0d\n        ].join('\\n')\x0d\n      );\x0d\n    }\x0d\n\x0d\n    if (exceptionHandlers) {\x0d\n      this.exceptions.handle(exceptionHandlers);\x0d\n    }\x0d\n    if (rejectionHandlers) {\x0d\n      this.rejections.handle(rejectionHandlers);\x0d\n    }\x0d\n  }\x0d\n\x0d\n  isLevelEnabled(level) {\x0d\n    const givenLevelValue = getLevelValue(this.levels\x2C level);\x0d\n    if (givenLevelValue === null) {\x0d\n      return false;\x0d\n    }\x0d\n\x0d\n    const configuredLevelValue = getLevelValue(this.levels\x2C this.level);\x0d\n    if (configuredLevelValue === null) {\x0d\n      return false;\x0d\n    }\x0d\n\x0d\n    if (!this.transports || this.transports.length === 0) {\x0d\n      return configuredLevelValue >= givenLevelValue;\x0d\n    }\x0d\n\x0d\n    const index = this.transports.findIndex(transport => {\x0d\n      let transportLevelValue = getLevelValue(this.levels\x2C transport.level);\x0d\n      if (transportLevelValue === null) {\x0d\n        transportLevelValue = configuredLevelValue;\x0d\n      }\x0d\n      return transportLevelValue >= givenLevelValue;\x0d\n    });\x0d\n    return index !== -1;\x0d\n  }\x0d\n\x0d\n  /* eslint-disable valid-jsdoc */\x0d\n  /**\x0d\n   * Ensure backwards compatibility with a `log` method\x0d\n   * @param {mixed} level - Level the log message is written at.\x0d\n   * @param {mixed} msg - TODO: add param description.\x0d\n   * @param {mixed} meta - TODO: add param description.\x0d\n   * @returns {Logger} - TODO: add return description.\x0d\n   *\x0d\n   * @example\x0d\n   *    // Supports the existing API:\x0d\n   *    logger.log('info'\x2C 'Hello world'\x2C { custom: true });\x0d\n   *    logger.log('info'\x2C new Error('Yo\x2C it\\'s on fire'));\x0d\n   *\x0d\n   *    // Requires winston.format.splat()\x0d\n   *    logger.log('info'\x2C '%s %d%%'\x2C 'A string'\x2C 50\x2C { thisIsMeta: true });\x0d\n   *\x0d\n   *    // And the new API with a single JSON literal:\x0d\n   *    logger.log({ level: 'info'\x2C message: 'Hello world'\x2C custom: true });\x0d\n   *    logger.log({ level: 'info'\x2C message: new Error('Yo\x2C it\\'s on fire') });\x0d\n   *\x0d\n   *    // Also requires winston.format.splat()\x0d\n   *    logger.log({\x0d\n   *      level: 'info'\x2C\x0d\n   *      message: '%s %d%%'\x2C\x0d\n   *      [SPLAT]: ['A string'\x2C 50]\x2C\x0d\n   *      meta: { thisIsMeta: true }\x0d\n   *    });\x0d\n   *\x0d\n   */\x0d\n  /* eslint-enable valid-jsdoc */\x0d\n  log(level\x2C msg\x2C ...splat) {\x0d\n    // eslint-disable-line max-params\x0d\n    // Optimize for the hotpath of logging JSON literals\x0d\n    if (arguments.length === 1) {\x0d\n      // Yo dawg\x2C I heard you like levels ... seriously ...\x0d\n      // In this context the LHS `level` here is actually the `info` so read\x0d\n      // this as: info[LEVEL] = info.level;\x0d\n      level[LEVEL] = level.level;\x0d\n      this._addDefaultMeta(level);\x0d\n      this.write(level);\x0d\n      return this;\x0d\n    }\x0d\n\x0d\n    // Slightly less hotpath\x2C but worth optimizing for.\x0d\n    if (arguments.length === 2) {\x0d\n      if (msg && typeof msg === 'object') {\x0d\n        msg[LEVEL] = msg.level = level;\x0d\n        this._addDefaultMeta(msg);\x0d\n        this.write(msg);\x0d\n        return this;\x0d\n      }\x0d\n\x0d\n      msg = { [LEVEL]: level\x2C level\x2C message: msg };\x0d\n      this._addDefaultMeta(msg);\x0d\n      this.write(msg);\x0d\n      return this;\x0d\n    }\x0d\n\x0d\n    const [meta] = splat;\x0d\n    if (typeof meta === 'object' && meta !== null) {\x0d\n      // Extract tokens\x2C if none available default to empty array to\x0d\n      // ensure consistancy in expected results\x0d\n      const tokens = msg && msg.match && msg.match(formatRegExp);\x0d\n\x0d\n      if (!tokens) {\x0d\n        const info = Object.assign({}\x2C this.defaultMeta\x2C meta\x2C {\x0d\n          [LEVEL]: level\x2C\x0d\n          [SPLAT]: splat\x2C\x0d\n          level\x2C\x0d\n          message: msg\x0d\n        });\x0d\n\x0d\n        if (meta.message) info.message = `${info.message} ${meta.message}`;\x0d\n        if (meta.stack) info.stack = meta.stack;\x0d\n\x0d\n        this.write(info);\x0d\n        return this;\x0d\n      }\x0d\n    }\x0d\n\x0d\n    this.write(Object.assign({}\x2C this.defaultMeta\x2C {\x0d\n      [LEVEL]: level\x2C\x0d\n      [SPLAT]: splat\x2C\x0d\n      level\x2C\x0d\n      message: msg\x0d\n    }));\x0d\n\x0d\n    return this;\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * Pushes data so that it can be picked up by all of our pipe targets.\x0d\n   * @param {mixed} info - TODO: add param description.\x0d\n   * @param {mixed} enc - TODO: add param description.\x0d\n   * @param {mixed} callback - Continues stream processing.\x0d\n   * @returns {undefined}\x0d\n   * @private\x0d\n   */\x0d\n  _transform(info\x2C enc\x2C callback) {\x0d\n    if (this.silent) {\x0d\n      return callback();\x0d\n    }\x0d\n\x0d\n    // [LEVEL] is only soft guaranteed to be set here since we are a proper\x0d\n    // stream. It is likely that `info` came in through `.log(info)` or\x0d\n    // `.info(info)`. If it is not defined\x2C however\x2