script-source,583,C:\\Users\\sella\\Desktop\\Programacion\\CoderHouse\\Backend\\Desafio14\\node_modules\\winston\\lib\\winston\\tail-file.js,/**\x0d\n * tail-file.js: TODO: add file header description.\x0d\n *\x0d\n * (C) 2010 Charlie Robbins\x0d\n * MIT LICENCE\x0d\n */\x0d\n\x0d\n'use strict';\x0d\n\x0d\nconst fs = require('fs');\x0d\nconst { StringDecoder } = require('string_decoder');\x0d\nconst { Stream } = require('readable-stream');\x0d\n\x0d\n/**\x0d\n * Simple no-op function.\x0d\n * @returns {undefined}\x0d\n */\x0d\nfunction noop() {}\x0d\n\x0d\n/**\x0d\n * TODO: add function description.\x0d\n * @param {Object} options - Options for tail.\x0d\n * @param {function} iter - Iterator function to execute on every line.\x0d\n* `tail -f` a file. Options must include file.\x0d\n * @returns {mixed} - TODO: add return description.\x0d\n */\x0d\nmodule.exports = (options\x2C iter) => {\x0d\n  const buffer = Buffer.alloc(64 * 1024);\x0d\n  const decode = new StringDecoder('utf8');\x0d\n  const stream = new Stream();\x0d\n  let buff = '';\x0d\n  let pos = 0;\x0d\n  let row = 0;\x0d\n\x0d\n  if (options.start === -1) {\x0d\n    delete options.start;\x0d\n  }\x0d\n\x0d\n  stream.readable = true;\x0d\n  stream.destroy = () => {\x0d\n    stream.destroyed = true;\x0d\n    stream.emit('end');\x0d\n    stream.emit('close');\x0d\n  };\x0d\n\x0d\n  fs.open(options.file\x2C 'a+'\x2C '0644'\x2C (err\x2C fd) => {\x0d\n    if (err) {\x0d\n      if (!iter) {\x0d\n        stream.emit('error'\x2C err);\x0d\n      } else {\x0d\n        iter(err);\x0d\n      }\x0d\n      stream.destroy();\x0d\n      return;\x0d\n    }\x0d\n\x0d\n    (function read() {\x0d\n      if (stream.destroyed) {\x0d\n        fs.close(fd\x2C noop);\x0d\n        return;\x0d\n      }\x0d\n\x0d\n      return fs.read(fd\x2C buffer\x2C 0\x2C buffer.length\x2C pos\x2C (error\x2C bytes) => {\x0d\n        if (error) {\x0d\n          if (!iter) {\x0d\n            stream.emit('error'\x2C error);\x0d\n          } else {\x0d\n            iter(error);\x0d\n          }\x0d\n          stream.destroy();\x0d\n          return;\x0d\n        }\x0d\n\x0d\n        if (!bytes) {\x0d\n          if (buff) {\x0d\n            // eslint-disable-next-line eqeqeq\x0d\n            if (options.start == null || row > options.start) {\x0d\n              if (!iter) {\x0d\n                stream.emit('line'\x2C buff);\x0d\n              } else {\x0d\n                iter(null\x2C buff);\x0d\n              }\x0d\n            }\x0d\n            row++;\x0d\n            buff = '';\x0d\n          }\x0d\n          return setTimeout(read\x2C 1000);\x0d\n        }\x0d\n\x0d\n        let data = decode.write(buffer.slice(0\x2C bytes));\x0d\n        if (!iter) {\x0d\n          stream.emit('data'\x2C data);\x0d\n        }\x0d\n\x0d\n        data = (buff + data).split(/\\n+/);\x0d\n\x0d\n        const l = data.length - 1;\x0d\n        let i = 0;\x0d\n\x0d\n        for (; i < l; i++) {\x0d\n          // eslint-disable-next-line eqeqeq\x0d\n          if (options.start == null || row > options.start) {\x0d\n            if (!iter) {\x0d\n              stream.emit('line'\x2C data[i]);\x0d\n            } else {\x0d\n              iter(null\x2C data[i]);\x0d\n            }\x0d\n          }\x0d\n          row++;\x0d\n        }\x0d\n\x0d\n        buff = data[l];\x0d\n        pos += bytes;\x0d\n        return read();\x0d\n      });\x0d\n    }());\x0d\n  });\x0d\n\x0d\n  if (!iter) {\x0d\n    return stream;\x0d\n  }\x0d\n\x0d\n  return stream.destroy;\x0d\n};\x0d\n
