ug('close'\x2C dest.path\x2C dest.bytesWritten))\x0d\n      .on('open'\x2C () => {\x0d\n        debug('file open ok'\x2C fullpath);\x0d\n        this.emit('open'\x2C fullpath);\x0d\n        source.pipe(dest);\x0d\n\x0d\n        // If rotation occured during the open operation then we immediately\x0d\n        // start writing to a new PassThrough\x2C begin opening the next file\x0d\n        // and cleanup the previous source and dest once the source has drained.\x0d\n        if (this.rotatedWhileOpening) {\x0d\n          this._stream = new PassThrough();\x0d\n          this._stream.setMaxListeners(30);\x0d\n          this._rotateFile();\x0d\n          this.rotatedWhileOpening = false;\x0d\n          this._cleanupStream(dest);\x0d\n          source.end();\x0d\n        }\x0d\n      });\x0d\n\x0d\n    debug('create stream ok'\x2C fullpath);\x0d\n    if (this.zippedArchive) {\x0d\n      const gzip = zlib.createGzip();\x0d\n      gzip.pipe(dest);\x0d\n      return gzip;\x0d\n    }\x0d\n\x0d\n    return dest;\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * TODO: add method description.\x0d\n   * @param {function} callback - TODO: add param description.\x0d\n   * @returns {undefined}\x0d\n   */\x0d\n  _incFile(callback) {\x0d\n    debug('_incFile'\x2C this.filename);\x0d\n    const ext = path.extname(this._basename);\x0d\n    const basename = path.basename(this._basename\x2C ext);\x0d\n\x0d\n    if (!this.tailable) {\x0d\n      this._created += 1;\x0d\n      this._checkMaxFilesIncrementing(ext\x2C basename\x2C callback);\x0d\n    } else {\x0d\n      this._checkMaxFilesTailable(ext\x2C basename\x2C callback);\x0d\n    }\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * Gets the next filename to use for this instance in the case that log\x0d\n   * filesizes are being capped.\x0d\n   * @returns {string} - TODO: add return description.\x0d\n   * @private\x0d\n   */\x0d\n  _getFile() {\x0d\n    const ext = path.extname(this._basename);\x0d\n    const basename = path.basename(this._basename\x2C ext);\x0d\