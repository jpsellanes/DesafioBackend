script-source,512,C:\\Users\\sella\\Desktop\\Programacion\\CoderHouse\\Backend\\Desafio14\\node_modules\\winston\\lib\\winston\\create-logger.js,/**\x0d\n * create-logger.js: Logger factory for winston logger instances.\x0d\n *\x0d\n * (C) 2010 Charlie Robbins\x0d\n * MIT LICENCE\x0d\n */\x0d\n\x0d\n'use strict';\x0d\n\x0d\nconst { LEVEL } = require('triple-beam');\x0d\nconst config = require('./config');\x0d\nconst Logger = require('./logger');\x0d\nconst debug = require('@dabh/diagnostics')('winston:create-logger');\x0d\n\x0d\nfunction isLevelEnabledFunctionName(level) {\x0d\n  return 'is' + level.charAt(0).toUpperCase() + level.slice(1) + 'Enabled';\x0d\n}\x0d\n\x0d\n/**\x0d\n * Create a new instance of a winston Logger. Creates a new\x0d\n * prototype for each instance.\x0d\n * @param {!Object} opts - Options for the created logger.\x0d\n * @returns {Logger} - A newly created logger instance.\x0d\n */\x0d\nmodule.exports = function (opts = {}) {\x0d\n  //\x0d\n  // Default levels: npm\x0d\n  //\x0d\n  opts.levels = opts.levels || config.npm.levels;\x0d\n\x0d\n  /**\x0d\n   * DerivedLogger to attach the logs level methods.\x0d\n   * @type {DerivedLogger}\x0d\n   * @extends {Logger}\x0d\n   */\x0d\n  class DerivedLogger extends Logger {\x0d\n    /**\x0d\n     * Create a new class derived logger for which the levels can be attached to\x0d\n     * the prototype of. This is a V8 optimization that is well know to increase\x0d\n     * performance of prototype functions.\x0d\n     * @param {!Object} options - Options for the created logger.\x0d\n     */\x0d\n    constructor(options) {\x0d\n      super(options);\x0d\n    }\x0d\n  }\x0d\n\x0d\n  const logger = new DerivedLogger(opts);\x0d\n\x0d\n  //\x0d\n  // Create the log level methods for the derived logger.\x0d\n  //\x0d\n  Object.keys(opts.levels).forEach(function (level) {\x0d\n    debug('Define prototype method for "%s"'\x2C level);\x0d\n    if (level === 'log') {\x0d\n      // eslint-disable-next-line no-console\x0d\n      console.warn('Level "log" not defined: conflicts with the method "log". Use a different level name.');\x0d\n      return;\x0d\n    }\x0d\n\x0d\n    //\x0d\n    // Define prototype methods for each log level e.g.:\x0d\n    // logger.log('info'\x2C msg) implies these methods are defined:\x0d\n    // - logger.info(msg)\x0d\n    // - logger.isInfoEnabled()\x0d\n    //\x0d\n    // Remark: to support logger.child this **MUST** be a function\x0d\n    // so it'll always be called on the instance instead of a fixed\x0d\n    // place in the prototype chain.\x0d\n    //\x0d\n    DerivedLogger.prototype[level] = function (...args) {\x0d\n      // Prefer any instance scope\x2C but default to "root" logger\x0d\n      const self = this || logger;\x0d\n\x0d\n      // Optimize the hot-path which is the single object.\x0d\n      if (args.length === 1) {\x0d\n        const [msg] = args;\x0d\n        const info = msg && msg.message && msg || { message: msg };\x0d\n        info.level = info[LEVEL] = level;\x0d\n        self._addDefaultMeta(info);\x0d\n        self.write(info);\x0d\n        return (this || logger);\x0d\n      }\x0d\n\x0d\n      // When provided nothing assume the empty string\x0d\n      if (args.length === 0) {\x0d\n        self.log(level\x2C '');\x0d\n        return self;\x0d\n      }\x0d\n\x0d\n      // Otherwise build argument list which could potentially conform to\x0d\n      // either:\x0d\n      // . v3 API: log(obj)\x0d\n      // 2. v1/v2 API: log(level\x2C msg\x2C ... [string interpolate]\x2C [{metadata}]\x2C [callback])\x0d\n      return self.log(level\x2C ...args);\x0d\n    };\x0d\n\x0d\n    DerivedLogger.prototype[isLevelEnabledFunctionName(level)] = function () {\x0d\n      return (this || logger).isLevelEnabled(level);\x0d\n    };\x0d\n  });\x0d\n\x0d\n  return logger;\x0d\n};\x0d\n
