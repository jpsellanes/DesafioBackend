script-source,579,C:\\Users\\sella\\Desktop\\Programacion\\CoderHouse\\Backend\\Desafio14\\node_modules\\winston\\lib\\winston\\transports\\file.js,/* eslint-disable complexity\x2Cmax-statements */\x0d\n/**\x0d\n * file.js: Transport for outputting to a local log file.\x0d\n *\x0d\n * (C) 2010 Charlie Robbins\x0d\n * MIT LICENCE\x0d\n */\x0d\n\x0d\n'use strict';\x0d\n\x0d\nconst fs = require('fs');\x0d\nconst path = require('path');\x0d\nconst asyncSeries = require('async/series');\x0d\nconst zlib = require('zlib');\x0d\nconst { MESSAGE } = require('triple-beam');\x0d\nconst { Stream\x2C PassThrough } = require('readable-stream');\x0d\nconst TransportStream = require('winston-transport');\x0d\nconst debug = require('@dabh/diagnostics')('winston:file');\x0d\nconst os = require('os');\x0d\nconst tailFile = require('../tail-file');\x0d\n\x0d\n/**\x0d\n * Transport for outputting to a local log file.\x0d\n * @type {File}\x0d\n * @extends {TransportStream}\x0d\n */\x0d\nmodule.exports = class File extends TransportStream {\x0d\n  /**\x0d\n   * Constructor function for the File transport object responsible for\x0d\n   * persisting log messages and metadata to one or more files.\x0d\n   * @param {Object} options - Options for this instance.\x0d\n   */\x0d\n  constructor(options = {}) {\x0d\n    super(options);\x0d\n\x0d\n    // Expose the name of this Transport on the prototype.\x0d\n    this.name = options.name || 'file';\x0d\n\x0d\n    // Helper function which throws an `Error` in the event that any of the\x0d\n    // rest of the arguments is present in `options`.\x0d\n    function throwIf(target\x2C ...args) {\x0d\n      args.slice(1).forEach(name => {\x0d\n        if (options[name]) {\x0d\n          throw new Error(`Cannot set ${name} and ${target} together`);\x0d\n        }\x0d\n      });\x0d\n    }\x0d\n\x0d\n    // Setup the base stream that always gets piped to to handle buffering.\x0d\n    this._stream = new PassThrough();\x0d\n    this._stream.setMaxListeners(30);\x0d\n\x0d\n    // Bind this context for listener methods.\x0d\n    this._onError = this._onError.bind(this);\x0d\n\x0d\n    if (options.filename || options.dirname) {\x0d\n      throwIf('filename or dirname'\x2C 'stream');\x0d\n      this._basename = this.filename = options.filename\x0d\n        ? path.basename(options.filename)\x0d\n        : 'winston.log';\x0d\n\x0d\n      this.dirname = options.dirname || path.dirname(options.filename);\x0d\n      this.options = options.options || { flags: 'a' };\x0d\n    } else if (options.stream) {\x0d\n      // eslint-disable-next-line no-console\x0d\n      console.warn('options.stream will be removed in winston@4. Use winston.transports.Stream');\x0d\n      throwIf('stream'\x2C 'filename'\x2C 'maxsize');\x0d\n      this._dest = this._stream.pipe(this._setupStream(options.stream));\x0d\n      this.dirname = path.dirname(this._dest.path);\x0d\n      // We need to listen for drain events when write() returns false. This\x0d\n      // can make node mad at times.\x0d\n    } else {\x0d\n      throw new Error('Cannot log to file without filename or stream.');\x0d\n    }\x0d\n\x0d\n    this.maxsize = options.maxsize || null;\x0d\n    this.rotationFormat = options.rotationFormat || false;\x0d\n    this.zippedArchive = options.zippedArchive || false;\x0d\n    this.maxFiles = options.maxFiles || null;\x0d\n    this.eol = (typeof options.eol === 'string') ? options.eol : os.EOL;\x0d\n    this.tailable = options.tailable || false;\x0d\n\x0d\n    // Internal state variables representing the number of files this instance\x0d\n    // has created and the current size (in bytes) of the current logfile.\x0d\n    this._size = 0;\x0d\n    this._pendingSize = 0;\x0d\n    this._created = 0;\x0d\n    this._drain = false;\x0d\n    this._opening = false;\x0d\n    this._ending = false;\x0d\n\x0d\n    if (this.dirname) this._createLogDirIfNotExist(this.dirname);\x0d\n    this.open();\x0d\n  }\x0d\n\x0d\n  finishIfEnding() {\x0d\n    if (this._ending) {\x0d\n      if (this._opening) {\x0d\n        this.once('open'\x2C () => {\x0d\n          this._stream.once('finish'\x2C () => this.emit('finish'));\x0d\n          setImmediate(() => this._stream.end());\x0d\n        });\x0d\n      } else {\x0d\n        this._stream.once('finish'\x2C () => this.emit('finish'));\x0d\n        setImmediate(() => this._stream.end());\x0d\n      }\x0d\n    }\x0d\n  }\x0d\n\x0d\n\x0d\n  /**\x0d\n   * Core logging method exposed to Winston. Metadata is optional.\x0d\n   * @param {Object} info - TODO: add param description.\x0d\n   * @param {Function} callback - TODO: add param description.\x0d\n   * @returns {undefined}\x0d\n   */\x0d\n  log(info\x2C callback = () => {}) {\x0d\n    // Remark: (jcrugzz) What is necessary about this callback(null\x2C true) now\x0d\n    // when thinking about 3.x? Should silent be handled in the base\x0d\n    // TransportStream _write method?\x0d\n    if (this.silent) {\x0d\n      callback();\x0d\n      return true;\x0d\n    }\x0d\n\x0d\n    // Output stream buffer is full and has asked us to wait for the drain event\x0d\n    if (this._drain) {\x0d\n      this._stream.once('drain'\x2C () => {\x0d\n        this._drain = false;\x0d\n        this.log(info\x2C callback);\x0d\n      });\x0d\n      return;\x0d\n    }\x0d\n    if (this._rotate) {\x0d\n      this._stream.once('rotate'\x2C () => {\x0d\n        this._rotate = false;\x0d\n        this.log(info\x2C callback);\x0d\n      });\x0d\n      return;\x0d\n    }\x0d\n\x0d\n    // Grab the raw string and append the expected EOL.\x0d\n    const output = `${info[MESSAGE]}${this.eol}`;\x0d\n    const bytes = Buffer.byteLength(output);\x0d\n\x0d\n    // After we have written to the PassThrough check to see if we need\x0d\n    // to rotate to the next file.\x0d\n    //\x0d\n    // Remark: This gets called too early and does not depict when data\x0d\n    // has been actually flushed to disk.\x0d\n    function logged() {\x0d\n      this._size += bytes;\x0d\n      this._pendingSize -= bytes;\x0d\n\x0d\n      debug('logged %s %s'\x2C this._size\x2C output);\x0d\n      this.emit('logged'\x2C info);\x0d\n\x0d\n      // Do not attempt to rotate files while opening\x0d\n      if (this._opening) {\x0d\n        return;\x0d\n      }\x0d\n\x0d\n      // Check to see if we need to end the stream and create a new one.\x0d\n      if (!this._needsNewFile()) {\x0d\n        return;\x0d\n      }\x0d\n\x0d\n      // End the current stream\x2C ensure it flushes and create a new one.\x0d\n      // This could potentially be optimized to not run a stat call but its\x0d\n      // the safest way since we are supporting `maxFiles`.\x0d\n      this._rotate = true;\x0d\n      this._endStream(() => this._rotateFile());\x0d\n    }\x0d\n\x0d\n    // Keep track of the pending bytes being written while files are opening\x0d\n    // in order to properly rotate the PassThrough this._stream when the file\x0d\n    // eventually does open.\x0d\n    this._pendingSize += bytes;\x0d\n    if (this._opening\x0d\n      && !this.rotatedWhileOpening\x0d\n      && this._needsNewFile(this._size + this._pendingSize)) {\x0d\n      this.rotatedWhileOpening = true;\x0d\n    }\x0d\n\x0d\n    const written = this._stream.write(output\x2C logged.bind(this));\x0d\n    if (!written) {\x0d\n      this._drain = true;\x0d\n      this._stream.once('drain'\x2C () => {\x0d\n        this._drain = false;\x0d\n        callback();\x0d\n      });\x0d\n    } else {\x0d\n      callback(); // eslint-disable-line callback-return\x0d\n    }\x0d\n\x0d\n    debug('written'\x2C written\x2C this._drain);\x0d\n\x0d\n    this.finishIfEnding();\x0d\n\x0d\n    return written;\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * Query the transport. Options object is optional.\x0d\n   * @param {Object} options - Loggly-like query options for this instance.\x0d\n   * @param {function} callback - Continuation to respond to when complete.\x0d\n   * TODO: Refactor me.\x0d\n   */\x0d\n  query(options\x2C callback) {\x0d\n    if (typeof options === 'function') {\x0d\n      callback = options;\x0d\n      options = {};\x0d\n    }\x0d\n\x0d\n    options = normalizeQuery(options);\x0d\n    const file = path.join(this.dirname\x2C this.filename);\x0d\n    let buff = '';\x0d\n    let results = [];\x0d\n    let row = 0;\x0d\n\x0d\n    const stream = fs.createReadStream(file\x2C {\x0d\n      encoding: 'utf8'\x0d\n    });\x0d\n\x0d\n    stream.on('error'\x2C err => {\x0d\n      if (stream.readable) {\x0d\n        stream.destroy();\x0d\n      }\x0d\n      if (!callback) {\x0d\n        return;\x0d\n      }\x0d\n\x0d\n      return err.code !== 'ENOENT' ? callback(err) : callback(null\x2C results);\x0d\n    });\x0d\n\x0d\n    stream.on('data'\x2C data => {\x0d\n      data = (buff + data).split(/\\n+/);\x0d\n      const l = data.length - 1;\x0d\n      let i = 0;\x0d\n\x0d\n      for (; i < l; i++) {\x0d\n        if (!options.start || row >= options.start) {\x0d\n          add(data[i]);\x0d\n        }\x0d\n        row++;\x0d\n      }\x0d\n\x0d\n      buff = data[l];\x0d\n    });\x0d\n\x0d\n    stream.on('close'\x2C () => {\x0d\n      if (buff) {\x0d\n        add(buff\x2C true);\x0d\n      }\x0d\n      if (options.order === 'desc') {\x0d\n        results = results.reverse();\x0d\n      }\x0d\n\x0d\n      // eslint-disable-next-line callback-return\x0d\n      if (callback) callback(null\x2C results);\x0d\n    });\x0d\n\x0d\n    function add(buff\x2C attempt) {\x0d\n      try {\x0d\n        const log = JSON.parse(buff);\x0d\n        if (check(log)) {\x0d\n          push(log);\x0d\n        }\x0d\n      } catch (e) {\x0d\n        if (!attempt) {\x0d\n          stream.emit('error'\x2C e);\x0d\n        }\x0d\n      }\x0d\n    }\x0d\n\x0d\n    function push(log) {\x0d\n      if (\x0d\n        options.rows &&\x0d\n        results.length >= options.rows &&\x0d\n        options.order !== 'desc'\x0d\n      ) {\x0d\n        if (stream.readable) {\x0d\n          stream.destroy();\x0d\n        }\x0d\n        return;\x0d\n      }\x0d\n\x0d\n      if (options.fields) {\x0d\n        log = options.fields.reduce((obj\x2C key) => {\x0d\n          obj[key] = log[key];\x0d\n          return obj;\x0d\n        }\x2C {});\x0d\n      }\x0d\n\x0d\n      if (options.order === 'desc') {\x0d\n        if (results.length >= options.rows) {\x0d\n          results.shift();\x0d\n        }\x0d\n      }\x0d\n      results.push(log);\x0d\n    }\x0d\n\x0d\n    function check(log) {\x0d\n      if (!log) {\x0d\n        return;\x0d\n      }\x0d\n\x0d\n      if (typeof log !== 'object') {\x0d\n        return;\x0d\n      }\x0d\n\x0d\n      const time = new Date(log.timestamp);\x0d\n      if (\x0d\n        (options.from && time < options.from) ||\x0d\n        (options.until && time > options.until) ||\x0d\n        (options.level && options.level !== log.level)\x0d\n      ) {\x0d\n        return;\x0d\n      }\x0d\n\x0d\n      return true;\x0d\n    }\x0d\n\x0d\n    function normalizeQuery(options) {\x0d\n      options = options || {};\x0d\n\x0d\n      // limit\x0d\n      options.rows = options.rows || options.limit || 10;\x0d\n\x0d\n      // starting row offset\x0d\n      options.start = options.start || 0;\x0d\n\x0d\n      // now\x0d\n      options.until = options.until || new Date();\x0d\n      if (typeof options.until !== 'object') {\x0d\n        options.until = new Date(options.until);\x0d\n      }\x0d\n\x0d\n      // now - 24\x0d\n      options.from = options.from || (options.until - (24 * 60 * 60 * 1000));\x0d\n      if (typeof options.from !== 'object') {\x0d\n        options.from = new Date(options.from);\x0d\n      }\x0d\n\x0d\n      // 'asc' or 'desc'\x0d\n      options.order = options.order || 'desc';\x0d\n\x0d\n      return options;\x0d\n    }\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * Returns a log stream for this transport. Options object is optional.\x0d\n   * @param {Object} options - Stream options for this instance.\x0d\n   * @returns {Stream} - TODO: add return description.\x0d\n   * TODO: Refactor me.\x0d\n   */\x0d\n  stream(options = {}) {\x0d\n    const file = path.join(this.dirname\x2C this.filename);\x0d\n    const stream = new Stream();\x0d\n    const tail = {\x0d\n      file\x2C\x0d\n      start: options.start\x0d\n    };\x0d\n\x0d\n    stream.destroy = tailFile(tail\x2C (err\x2C line) => {\x0d\n      if (err) {\x0d\n        return stream.emit('error'\x2C err);\x0d\n      }\x0d\n\x0d\n      try {\x0d\n        stream.emit('data'\x2C line);\x0d\n        line = JSON.parse(line);\x0d\n        stream.emit('log'\x2C line);\x0d\n      } catch (e) {\x0d\n        stream.emit('error'\x2C e);\x0d\n      }\x0d\n    });\x0d\n\x0d\n    return stream;\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * Checks to see the filesize of.\x0d\n   * @returns {undefined}\x0d\n   */\x0d\n  open() {\x0d\n    // If we do not have a filename then we were passed a stream and\x0d\n    // don't need to keep track of size.\x0d\n    if (!this.filename) return;\x0d\n    if (this._opening) return;\x0d\n\x0d\n    this._opening = true;\x0d\n\x0d\n    // Stat the target file to get the size and create the stream.\x0d\n    this.stat((err\x2C size) => {\x0d\n      if (err) {\x0d\n        return this.emit('error'\x2C err);\x0d\n      }\x0d\n      debug('stat done: %s { size: %s }'\x2C this.filename\x2C size);\x0d\n      this._size = size;\x0d\n      this._dest = this._createStream(this._stream);\x0d\n      this._opening = false;\x0d\n      this.once('open'\x2C () => {\x0d\n        if (this._stream.eventNames().includes('rotate')) {\x0d\n          this._stream.emit('rotate');\x0d\n        } else {\x0d\n          this._rotate = false;\x0d\n        }\x0d\n      });\x0d\n    });\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * Stat the file and assess information in order to create the proper stream.\x0d\n   * @param {function} callback - TODO: add param description.\x0d\n   * @returns {undefined}\x0d\n   */\x0d\n  stat(callback) {\x0d\n    const target = this._getFile();\x0d\n    const fullpath = path.join(this.dirname\x2C target);\x0d\n\x0d\n    fs.stat(fullpath\x2C (err\x2C stat) => {\x0d\n      if (err && err.code === 'ENOENT') {\x0d\n        debug('ENOENT\xa0ok'\x2C fullpath);\x0d\n        // Update internally tracked filename with the new target name.\x0d\n        this.filename = target;\x0d\n        return callback(null\x2C 0);\x0d\n      }\x0d\n\x0d\n      if (err) {\x0d\n        debug(`err ${err.code} ${fullpath}`);\x0d\n        return callback(err);\x0d\n      }\x0d\n\x0d\n      if (!stat || this._needsNewFile(stat.size)) {\x0d\n        // If `stats.size` is greater than the `maxsize` for this\x0d\n        // instance then try again.\x0d\n        return this._incFile(() => this.stat(callback));\x0d\n      }\x0d\n\x0d\n      // Once we have figured out what the filename is\x2C set it\x0d\n      // and return the size.\x0d\n      this.filename = target;\x0d\n      callback(null\x2C stat.size);\x0d\n    });\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * Closes the stream associated with this instance.\x0d\n   * @param {function} cb - TODO: add param description.\x0d\n   * @returns {undefined}\x0d\n   */\x0d\n  close(cb) {\x0d\n    if (!this._stream) {\x0d\n      return;\x0d\n    }\x0d\n\x0d\n    this._stream.end(() => {\x0d\n      if (cb) {\x0d\n        cb(); // eslint-disable-line callback-return\x0d\n      }\x0d\n      this.emit('flush');\x0d\n      this.emit('closed');\x0d\n    });\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * TODO: add method description.\x0d\n   * @param {number} size - TODO: add param description.\x0d\n   * @returns {undefined}\x0d\n   */\x0d\n  _needsNewFile(size) {\x0d\n    size = size || this._size;\x0d\n    return this.maxsize && size >= this.maxsize;\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * TODO: add method description.\x0d\n   * @param {Error} err - TODO: add param description.\x0d\n   * @returns {undefined}\x0d\n   */\x0d\n  _onError(err) {\x0d\n    this.emit('error'\x2C err);\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * TODO: add method description.\x0d\n   * @param {Stream} stream - TOD