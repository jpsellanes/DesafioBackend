b) {\n    this.collection.replaceOne(match\x2C update\x2C options\x2C cb);\n  }\n\n  /**\n   * deleteOne(match\x2C options\x2C function(err[\x2C result])\n   */\n  deleteOne(match\x2C options\x2C cb) {\n    this.collection.deleteOne(match\x2C options\x2C cb);\n  }\n\n  /**\n   * deleteMany(match\x2C options\x2C function(err[\x2C result])\n   */\n  deleteMany(match\x2C options\x2C cb) {\n    this.collection.deleteMany(match\x2C options\x2C cb);\n  }\n\n  /**\n   * remove(match\x2C options\x2C function(err[\x2C result])\n   */\n  remove(match\x2C options\x2C cb) {\n    this.collection.remove(match\x2C options\x2C cb);\n  }\n\n  /**\n   * findOneAndDelete(match\x2C options\x2C function(err[\x2C result])\n   */\n  findOneAndDelete(match\x2C options\x2C cb) {\n    this.collection.findOneAndDelete(match\x2C options\x2C cb);\n  }\n\n  /**\n   * findOneAndUpdate(match\x2C update\x2C options\x2C function(err[\x2C result])\n   */\n  findOneAndUpdate(match\x2C update\x2C options\x2C cb) {\n    this.collection.findOneAndUpdate(match\x2C update\x2C options\x2C cb);\n  }\n\n  /**\n   * var cursor = findCursor(match\x2C options)\n   */\n  findCursor(match\x2C options) {\n    return this.collection.find(match\x2C options);\n  }\n\n  /**\n   * aggregation(operators...\x2C function(err\x2C doc))\n   * TODO\n   */\n}\n\n\n/**\n * Expose\n */\n\nmodule.exports = exports = NodeCollection;\n
