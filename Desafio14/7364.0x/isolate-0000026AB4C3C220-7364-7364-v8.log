script-source,586,C:\\Users\\sella\\Desktop\\Programacion\\CoderHouse\\Backend\\Desafio14\\main.js,const fs = require('fs')\x0d\n\x0d\n//Se declara la clase Contenedor\x0d\nmodule.exports = class contenedor {\x0d\n    constructor(filename){\x0d\n        this.filename = filename;\x0d\n    }\x0d\n\x0d\n    async save(obj){\x0d\n    //Funcion Save\x2C guarda un nuevo objecto en el archivo\x0d\n        try{\x0d\n            let data = await fs.promises.readFile('./'+ this.filename)\x0d\n            //Leer antes de cambiar\x2C tengo que tranformarlos a algo que me sea mas facil modificar\x0d\n            const contenidoViejo = JSON.parse(data)\x0d\n            console.log(`Contenido Viejo: ${contenidoViejo}`)\x0d\n            //Ahora se tienen disponibles los datos para modificar\x0d\n            //Se evalua si hay duplicado\x0d\n            console.log(obj.title)\x0d\n            let found = false;\x0d\n            for(var i = 0; i< contenidoViejo.length; i++){\x0d\n                if(contenidoViejo[i].title == obj.title){\x0d\n                    found = true\x0d\n                    break;\x0d\n                }\x0d\n            }\x0d\n            console.log(found)\x0d\n\x0d\n            if(found == false){             //Item no existe\x0d\n                \x0d\n                obj.id = contenidoViejo.length + 1 //Se pone un ID provisorio\x0d\n                //Se busca el numero de ID maximo\x0d\n                let IdsArray = contenidoViejo.map(productos => productos.id)\x0d\n                console.log(IdsArray)\x0d\n                let maxID = Math.max(...IdsArray)\x0d\n                console.log(maxID)\x0d\n                //Check ID si esta repetido y corrige si es necesario\x2C en caso de borrar varios productos\x0d\n                //Se pueden solapar los IDs\x2C entonces se elige el IDmaximo + 1 como ID nuevo de ser necesario\x0d\n                if(maxID >= obj.id){\x0d\n                    obj.id = maxID + 1;\x0d\n                }\x0d\n                contenidoViejo.push( obj )\x0d\n                let contenidoNuevo = contenidoViejo\x0d\n                console.log(`Contenido Nuevo: ${contenidoNuevo}`)\x0d\n                console.log("Product ID = " + obj.id)\x0d\n                // Se guarda el File\x0d\n                return await fs.promises.writeFile('./'+ this.filename \x2C JSON.stringify(contenidoNuevo\x2C null\x2C 2))\x0d\n\x0d\n            } else if(found == true) {      //Item Repetido\x0d\n                console.log("This Product Already Exist")\x0d\n            }\x0d\n        }\x0d\n        catch(err){\x0d\n            console.log("ERROR with Save ->" + err)\x0d\n        }\x0d\n    }\x0d\n\x0d\n    async updateById(idNumber\x2C newData){\x0d\n        try{\x0d\n            let data = await fs.promises.readFile('./'+ this.filename)\x0d\n            const contenidoParseado = JSON.parse(data);\x0d\n            let prodIndex = contenidoParseado.findIndex(productos => productos.id == idNumber);\x0d\n            if(prodIndex != undefined){\x0d\n                console.log("nueva data pa update " + newData + "el index sera" + prodIndex)\x0d\n                contenidoParseado[prodIndex].title = newData.productoTitle\x0d\n                contenidoParseado[prodIndex].price = newData.productoPrice\x0d\n                console.log("El producto actualizado se debe ver asi " + contenidoParseado[prodIndex])\x0d\n                return await fs.promises.writeFile('./'+ this.filename \x2C JSON.stringify(contenidoParseado\x2C null\x2C 2))\x0d\n            } else {\x0d\n                console.log("Product Not Found for Update!")\x0d\n                return "Producto No Encontrado para Update"\x0d\n            }\x0d\n        }catch(err){\x0d\n            console.log("Error with UpdateByID " + err)\x0d\n        }\x0d\n    }\x0d\n\x0d\n    async getById(idNumber){\x0d\n    //Trae el item segun su ID unico\x0d\n        try{\x0d\n            let data = await fs.promises.readFile('./'+ this.filename)\x0d\n            const contenidoParseado = JSON.parse(data);\x0d\n            let prodPorId = contenidoParseado.find(productos => productos.id == idNumber);\x0d\n            if(prodPorId != undefined){\x0d\n                console.log(prodPorId)\x0d\n                return prodPorId\x0d\n            } else {\x0d\n                console.log("Product Not Found!")\x0d\n                return "Producto No Encontrado"\x0d\n            }\x0d\n        } catch(err){\x0d\n            console.log("ERROR with GetById-> " + err)\x0d\n        }\x0d\n    }\x0d\n    \x0d\n    async getByIdRandom(){\x0d\n        try{\x0d\n            let data = await fs.promises.readFile('./'+ this.filename)\x0d\n            const contenidoParseado = JSON.parse(data);\x0d\n            let productoRand = contenidoParseado[Math.floor(Math.random()*contenidoParseado.length)]\x0d\n            return productoRand\x0d\n        } catch(err){\x0d\n                console.log("ERROR with GetByIdRandom-> " + err)\x0d\n            }\x0d\n        }\x0d\n\x0d\n    async getAll(){\x0d\n        try{\x0d\n            let data = await fs.promises.readFile('./'+ this.filename)\x0d\n            const contParsed = JSON.parse(data);\x0d\n            //console.log(contParsed)\x0d\n            return contParsed\x0d\n        } catch(err){\x0d\n            console.log("ERROR -> " + err)\x0d\n        }\x0d\n    }\x0d\n\x0d\n    async deleteById(idNumber){\x0d\n        try{\x0d\n            let data = await fs.promises.readFile('./'+ this.filename)\x0d\n            const contParsed = JSON.parse(data);\x0d\n            let prodPorId = contParsed.find(productos => productos.id == idNumber);\x0d\n            if(prodPorId != undefined){\x0d\n                let prodListIndex = contParsed.findIndex(productos => productos.id == idNumber)\x0d\n                contParsed.splice(prodListIndex\x2C1)\x0d\n                console.log(contParsed) //Guardar el archivo\x0d\n                await fs.promises.writeFile('./'+ this.filename\x2C JSON.stringify(contParsed\x2C null\x2C 2)) //ojo este await\x0d\n            } else {\x0d\n                console.log("Product Not Found!")\x0d\n            }\x0d\n        } catch(err){\x0d\n            console.log("ERROR at Delete by ID" + err)\x0d\n        }\x0d\n    }\x0d\n\x0d\n\x0d\n    deleteAll(){\x0d\n        fs.promises.unlink('./'+ this.filename)\x0d\n        console.log("DATA DELETED")\x0d\n    }\x0d\n\x0d\n}\x0d\n\x0d\n/****** Quitar comentario para Verificar****** */\x0d\n//newContenedor.save({"title": "resaltador"\x2C "price": 340})\x0d\n//newContenedor.getById(1)\x0d\n//newContenedor.getById(234324)\x0d\n//newContenedor.getAll()\x0d\n//newContenedor.deleteById(2)\x0d\n//newContenedor.deleteById(1)\x0d\n//newContenedor.deleteAll()  ////CUIDADO BORRA EL PRODUCTOS.JSON  ////
