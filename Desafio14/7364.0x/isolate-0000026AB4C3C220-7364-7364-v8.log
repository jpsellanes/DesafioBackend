.useColors;\n\x09return util.inspect(v\x2C this.inspectOpts)\n\x09\x09.split('\\n')\n\x09\x09.map(str => str.trim())\n\x09\x09.join(' ');\n};\n\n/**\n * Map %O to `util.inspect()`\x2C allowing multiple lines if needed.\n */\n\nformatters.O = function (v) {\n\x09this.inspectOpts.colors = this.useColors;\n\x09return util.inspect(v\x2C this.inspectOpts);\n};\n
