0d\n    );\x0d\n  }\x0d\n\x0d\n  const {\x0d\n    data: keyData\x2C\x0d\n    format: keyFormat\x2C\x0d\n    type: keyType\x2C\x0d\n    passphrase: keyPassphrase\x0d\n  } = preparePublicOrPrivateKey(key);\x0d\n\x0d\n  const job = new SignJob(\x0d\n    callback ? kCryptoJobAsync : kCryptoJobSync\x2C\x0d\n    kSignJobModeVerify\x2C\x0d\n    keyData\x2C\x0d\n    keyFormat\x2C\x0d\n    keyType\x2C\x0d\n    keyPassphrase\x2C\x0d\n    data\x2C\x0d\n    algorithm\x2C\x0d\n    pssSaltLength\x2C\x0d\n    rsaPadding\x2C\x0d\n    dsaSigEnc\x2C\x0d\n    signature);\x0d\n\x0d\n  if (!callback) {\x0d\n    const { 0: err\x2C 1: result } = job.run();\x0d\n    if (err !== undefined)\x0d\n      throw err;\x0d\n\x0d\n    return result;\x0d\n  }\x0d\n\x0d\n  job.ondone = (error\x2C result) => {\x0d\n    if (error) return FunctionPrototypeCall(callback\x2C job\x2C error);\x0d\n    FunctionPrototypeCall(callback\x2C job\x2C null\x2C result);\x0d\n  };\x0d\n  job.run();\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  Sign\x2C\x0d\n  signOneShot\x2C\x0d\n  Verify\x2C\x0d\n  verifyOneShot\x2C\x0d\n};\x0d\n
