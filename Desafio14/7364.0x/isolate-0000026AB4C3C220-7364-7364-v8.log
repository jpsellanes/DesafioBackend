les.indexOf(str)) {\n    found = rules.filter(function(rule) {\n      return str.match(rule[0]);\n    });\n    if (found[0]) {\n      return str.replace(found[0][0]\x2C found[0][1]);\n    }\n  }\n  return str;\n}\n
