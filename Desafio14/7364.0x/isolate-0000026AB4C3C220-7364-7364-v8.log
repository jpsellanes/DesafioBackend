script-source,380,node:internal/dns/promises,'use strict';\x0d\nconst {\x0d\n  ArrayPrototypeMap\x2C\x0d\n  ObjectCreate\x2C\x0d\n  ObjectDefineProperty\x2C\x0d\n  Promise\x2C\x0d\n  ReflectApply\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  bindDefaultResolver\x2C\x0d\n  Resolver: CallbackResolver\x2C\x0d\n  validateHints\x2C\x0d\n  validateTimeout\x2C\x0d\n  validateTries\x2C\x0d\n  emitInvalidHostnameWarning\x2C\x0d\n  emitTypeCoercionDeprecationWarning\x2C\x0d\n  getDefaultVerbatim\x2C\x0d\n} = require('internal/dns/utils');\x0d\nconst { codes\x2C dnsException } = require('internal/errors');\x0d\nconst { toASCII } = require('internal/idna');\x0d\nconst { isIP } = require('internal/net');\x0d\nconst {\x0d\n  getaddrinfo\x2C\x0d\n  getnameinfo\x2C\x0d\n  ChannelWrap\x2C\x0d\n  GetAddrInfoReqWrap\x2C\x0d\n  GetNameInfoReqWrap\x2C\x0d\n  QueryReqWrap\x0d\n} = internalBinding('cares_wrap');\x0d\nconst {\x0d\n  ERR_INVALID_ARG_VALUE\x2C\x0d\n  ERR_MISSING_ARGS\x2C\x0d\n} = codes;\x0d\nconst {\x0d\n  validatePort\x2C\x0d\n  validateString\x2C\x0d\n  validateOneOf\x2C\x0d\n} = require('internal/validators');\x0d\n\x0d\nfunction onlookup(err\x2C addresses) {\x0d\n  if (err) {\x0d\n    this.reject(dnsException(err\x2C 'getaddrinfo'\x2C this.hostname));\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  const family = this.family || isIP(addresses[0]);\x0d\n  this.resolve({ address: addresses[0]\x2C family });\x0d\n}\x0d\n\x0d\nfunction onlookupall(err\x2C addresses) {\x0d\n  if (err) {\x0d\n    this.reject(dnsException(err\x2C 'getaddrinfo'\x2C this.hostname));\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  const family = this.family;\x0d\n\x0d\n  for (var i = 0; i < addresses.length; i++) {\x0d\n    const address = addresses[i];\x0d\n\x0d\n    addresses[i] = {\x0d\n      address\x2C\x0d\n      family: family || isIP(addresses[i])\x0d\n    };\x0d\n  }\x0d\n\x0d\n  this.resolve(addresses);\x0d\n}\x0d\n\x0d\nfunction createLookupPromise(family\x2C hostname\x2C all\x2C hints\x2C verbatim)