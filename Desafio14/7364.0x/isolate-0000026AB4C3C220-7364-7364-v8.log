script-source,565,C:\\Users\\sella\\Desktop\\Programacion\\CoderHouse\\Backend\\Desafio14\\node_modules\\enabled\\index.js,'use strict';\n\n/**\n * Checks if a given namespace is allowed by the given variable.\n *\n * @param {String} name namespace that should be included.\n * @param {String} variable Value that needs to be tested.\n * @returns {Boolean} Indication if namespace is enabled.\n * @public\n */\nmodule.exports = function enabled(name\x2C variable) {\n  if (!variable) return false;\n\n  var variables = variable.split(/[\\s\x2C]+/)\n    \x2C i = 0;\n\n  for (; i < variables.length; i++) {\n    variable = variables[i].replace('*'\x2C '.*?');\n\n    if ('-' === variable.charAt(0)) {\n      if ((new RegExp('^'+ variable.substr(1) +'$')).test(name)) {\n        return false;\n      }\n\n      continue;\n    }\n\n    if ((new RegExp('^'+ variable +'$')).test(name)) {\n      return true;\n    }\n  }\n\n  return false;\n};\n
