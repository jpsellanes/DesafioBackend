CoercionDeprecationWarning\x2C\x0d\n  getDefaultVerbatim\x2C\x0d\n  setDefaultResultOrder\x2C\x0d\n} = require('internal/dns/utils');\x0d\nconst {\x0d\n  ERR_INVALID_ARG_TYPE\x2C\x0d\n  ERR_INVALID_ARG_VALUE\x2C\x0d\n  ERR_MISSING_ARGS\x2C\x0d\n} = errors.codes;\x0d\nconst {\x0d\n  validateCallback\x2C\x0d\n  validatePort\x2C\x0d\n  validateString\x2C\x0d\n  validateOneOf\x2C\x0d\n} = require('internal/validators');\x0d\n\x0d\nconst {\x0d\n  GetAddrInfoReqWrap\x2C\x0d\n  GetNameInfoReqWrap\x2C\x0d\n  QueryReqWrap\x2C\x0d\n} = cares;\x0d\n\x0d\nconst dnsException = errors.dnsException;\x0d\n\x0d\nlet promises = null; // Lazy loaded\x0d\n\x0d\nfunction onlookup(err\x2C addresses) {\x0d\n  if (err) {\x0d\n    return this.callback(dnsException(err\x2C 'getaddrinfo'\x2C this.hostname));\x0d\n  }\x0d\n  this.callback(null\x2C addresses[0]\x2C this.family || isIP(addresses[0]));\x0d\n}\x0d\n\x0d\n\x0d\nfunction onlookupall(err\x2C addresses) {\x0d\n  if (err) {\x0d\n    return this.callback(dnsException(err\x2C 'getaddrinfo'\x2C this.hostname));\x0d\n  }\x0d\n\x0d\n  const family = this.family;\x0d\n  for (let i = 0; i < addresses.length; i++) {\x0d\n    const addr = addresses[i];\x0d\n    addresses[i] = {\x0d\n      address: addr\x2C\x0d\n      family: family || isIP(addr)\x0d\n    };\x0d\n  }\x0d\n\x0d\n  this.callback(null\x2C addresses);\x0d\n}\x0d\n\x0d\n\x0d\n// Easy DNS A/AAAA look up\x0d\n// lookup(hostname\x2C [options\x2C] callback)\x0d\nfunction lookup(hostname\x2C options\x2C callback) {\x0d\n  let hints = 0;\x0d\n  let family = -1;\x0d\n  let all = false;\x0d\n  let verbatim = getDefaultVerbatim();\x0d\n\x0d\n  // Parse arguments\x0d\n  if (hostname) {\x0d\n    validateString(hostname\x2C 'hostname');\x0d\n  }\x0d\n\x0d\n  if (typeof options === 'function') {\x0d\n    callback = options;\x0d\n    family = 0;\x0d\n  } else {\x0d\n    validateCallback(callback);\x0d\n\x0d\n    if (options !== null && typeof options === 'object') {\x0d\n      if (options.hints != null && typeof options.hints !== 'number') {\x0d\n        emitTypeCoercionDeprecationWarning();\x0d\n      }\x0d\n      hints = options.hints >>> 0;\x0d\n      if (options.family != null && typeof options.family !== 'number') {\x0d\n        emitTypeCoercionDeprecationWarning();\x0d\n      }\x0d\n      family = options.family >>> 0;\x0d\n      if (options.all != null && typeof options.all !== 'boolean') {\x0d\n        emitTypeCoercionDeprecationWarning();\x0d\n      }\x0d\n      all = options.all === true;\x0d\n      if (typeof options.verbatim === 'boolean') {\x0d\n        verbatim = options.verbatim === true;\x0d\n      } else if (options.verbatim != null) {\x0d\n        emitTypeCoercionDeprecationWarning();\x0d\n      }\x0d\n\x0d\n      validateHints(hints);\x0d\n    } else {\x0d\n      if (options != null && typeof options !== 'number') {\x0d\n        emitTypeCoercionDeprecationWarning();\x0d\n      }\x0d\n      family = options >>> 0;\x0d\n    }\x0d\n  }\x0d\n\x0d\n  validateOneOf(family\x2C 'family'\x2C [0\x2C 4\x2C 6]);\x0d\n\x0d\n  if (!hostname) {\x0d\n    emitInvalidHostnameWarning(hostname);\x0d\n    if (all) {\x0d\n      process.nextTick(callback\x2C null\x2C []);\x0d\n    } else {\x0d\n      process.nextTick(callback\x2C null\x2C null\x2C family === 6 ? 6 : 4);\x0d\n    }\x0d\n    return {};\x0d\n  }\x0d\n\x0d\n  const matchedFamily = isIP(hostname);\x0d\n  if (matchedFamily) {\x0d\n    if (all) {\x0d\n      process.nextTick(\x0d\n        callback\x2C null\x2C [{ address: hostname\x2C family: matchedFamily }]);\x0d\n    } else {\x0d\n      process.nextTick(callback\x2C null\x2C hostname\x2C matchedFamily);\x0d\n    }\x0d\n    return {};\x0d\n  }\x0d\n\x0d\n  const req = new GetAddrInfoReqWrap();\x0d\n  req.callback = callback;\x0d\n  req.family = family;\x0d\n  req.hostname = hostname;\x0d\n  req.oncomplete = all ? onlookupall : onlookup;\x0d\n\x0d\n  const err = cares.getaddrinfo(\x0d\n    req\x2C toASCII(hostname)\x2C family\x2C hints\x2C verbatim\x0d\n  );\x0d\n  if (err) {\x0d\n    process.nextTick(callback\x2C dnsException(err\x2C 'getaddrinfo'\x2C hostname));\x0d\n    return {};\x0d\n  }\x0d\n  return req;\x0d\n}\x0d\n\x0d\nObjectDefineProperty(lookup\x2C customPromisifyArgs\x2C\x0d\n                     { value: ['address'\x2C 'family']\x2C enumerable: false });\x0d\n\x0d\n\x0d\nfunction onlookupservice(err\x2C hostname\x2C service) {\x0d\n  if (err)\x0d\n    return this.callback(dnsException(err\x2C 'getnameinfo'\x2C this.hostname));\x0d\n\x0d\n  this.callback(null\x2C hostname\x2C service);\x0d\n}\x0d\n\x0d\n\x0d\nfunction lookupService(address\x2C port\x2C callback) {\x0d\n  if (arguments.length !== 3)\x0d\n    throw new ERR_MISSING_ARGS('address'\x2C 'port'\x2C 'callback');\x0d\n\x0d\n  if (isIP(address) === 0)\x0d\n    throw new ERR_INVALID_ARG_VALUE('address'\x2C address);\x0d\n\x0d\n  validatePort(port);\x0d\n\x0d\n  validateCallback(callback);\x0d\n\x0d\n  port = +port;\x0d\n\x0d\n  const req = new GetNameInfoReqWrap();\x0d\n  req.callback = callback;\x0d\n  req.hostname = address;\x0d\n  req.port = port;\x0d\n  req.oncomplete = onlookupservice;\x0d\n\x0d\n  const err = cares.getnameinfo(req\x2C address\x2C port);\x0d\n  if (err) throw dnsException(err\x2C 'getnameinfo'\x2C address);\x0d\n  return req;\x0d\n}\x0d\n\x0d\nObjectDefineProperty(lookupService\x2C customPromisifyArgs\x2C\x0d\n                     { value: ['hostname'\x2C 'service']\x2C enumerable: false });\x0d\n\x0d\n\x0d\nfunction onresolve(err\x2C result\x2C ttls) {\x0d\n  if (ttls && this.ttl)\x0d\n    result = ArrayPrototypeMap(\x0d\n      result\x2C (address\x2C index) => ({ address\x2C ttl: ttls[index] }));\x0d\n\x0d\n  if (err)\x0d\n    this.callback(dnsException(err\x2C this.bindingName\x2C this.hostname));\x0d\n  else\x0d\n    this.callback(null\x2C result);\x0d\n}\x0d\n\x0d\nfunction resolver(bindingName) {\x0d\n  function query(name\x2C /* options\x2C */ callback) {\x0d\n    let options;\x0d\n    if (arguments.length > 2) {\x0d\n      options = callback;\x0d\n      callback = arguments[2];\x0d\n    }\x0d\n\x0d\n    validateString(name\x2C 'name');\x0d\n    validateCallback(callback);\x0d\n\x0d\n    const req = new QueryReqWrap();\x0d\n    req.bindingName = bindingName;\x0d\n    req.callback = callback;\x0d\n    req.hostname = name;\x0d\n    req.oncomplete = onresolve;\x0d\n    req.ttl = !!(options && options.ttl);\x0d\n    const err = this._handle[bindingName](req\x2C toASCII(name));\x0d\n    if (err) throw dnsException(err\x2C bindingName\x2C name);\x0d\n    return req;\x0d\n  }\x0d\n  ObjectDefineProperty(query\x2C 'name'\x2C { value: bindingName });\x0d\n  return query;\x0d\n}\x0d\n\x0d\nconst resolveMap = ObjectCreate(null);\x0d\nResolver.prototype.resolveAny = resolveMap.ANY = resolver('queryAny');\x0d\nResolver.prototype.resolve4 = resolveMap.A = resolver('queryA');\x0d\nResolver.prototype.resolve6 = resolveMap.AAAA = resolver('queryAaaa');\x0d\nResolver.prototype.resolveCaa = resolveMap.CAA = resolver('queryCaa');\x0d\nResolver.prototype.resolveCname = resolveMap.CNAME = resolver('queryCname');\x0d\nResolver.prototype.resolveMx = resolveMap.MX = resolver('queryMx');\x0d\nResolver.prototype.resolveNs = resolveMap.NS = resolver('queryNs');\x0d\nResolver.prototype.resolveTxt = resolveMap.TXT = resolver('queryTxt');\x0d\nResolver.prototype.resolveSrv = resolveMap.SRV = resolver('querySrv');\x0d\nResolver.prototype.resolvePtr = resolveMap.PTR = resolver('queryPtr');\x0d\nResolver.prototype.resolveNaptr = resolveMap.NAPTR = resolver('queryNaptr');\x0d\nResolver.prototype.resolveSoa = resolveMap.SOA = resolver('querySoa');\x0d\nResolver.prototype.reverse = resolver('getHostByAddr');\x0d\n\x0d\nResolver.prototype.resolve = resolve;\x0d\n\x0d\nfunction resolve(hostname\x2C rrtype\x2C callback) {\x0d\n  let resolver;\x0d\n  if (typeof rrtype === 'string') {\x0d\n    resolver = resolveMap[rrtype];\x0d\n  } else if (typeof rrtype === 'function') {\x0d\n    resolver = resolveMap.A;\x0d\n    callback = rrtype;\x0d\n  } else {\x0d\n    throw new ERR_INVALID_ARG_TYPE('rrtype'\x2C 'string'\x2C rrtype);\x0d\n  }\x0d\n\x0d\n  if (typeof resolver === 'function') {\x0d\n    return ReflectApply(resolver\x2C this\x2C [hostname\x2C callback]);\x0d\n  }\x0d\n  throw new ERR_INVALID_ARG_VALUE('rrtype'\x2C rrtype);\x0d\n}\x0d\n\x0d\nfunction defaultResolverSetServers(servers) {\x0d\n  const resolver = new Resolver();\x0d\n\x0d\n  resolver.setServers(servers);\x0d\n  setDefaultResolver(resolver);\x0d\n  bindDefaultResolver(module.exports\x2C Resolver.prototype);\x0d\n\x0d\n  if (promises !== null)\x0d\n    bindDefaultResolver(promises\x2C promises.Resolver.prototype);\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  lookup\x2C\x0d\n  lookupService\x2C\x0d\n\x0d\n  Resolver\x2C\x0d\n  setDefaultResultOrder\x2C\x0d\n  setServers: defaultResolverSetServers\x2C\x0d\n\x0d\n  // uv_getaddrinfo flags\x0d\n  ADDRCONFIG: cares.AI_ADDRCONFIG\x2C\x0d\n  ALL: cares.AI_ALL\x2C\x0d\n  V4MAPPED: cares.AI_V4MAPPED\x2C\x0d\n\x0d\n  // ERROR CODES\x0d\n  NODATA: 'ENODATA'\x2C\x0d\n  FORMERR: 'EFORMERR'\x2C\x0d\n  SERVFAIL: 'ESERVFAIL'\x2C\x0d\n  NOTFOUND: 'ENOTFOUND'\x2C\x0d\n  NOTIMP: 'ENOTIMP'\x2C\x0d\n  REFUSED: 'EREFUSED'\x2C\x0d\n  BADQUERY: 'EBADQUERY'\x2C\x0d\n  BADNAME: 'EBADNAME'\x2C\x0d\n  BADFAMILY: 'EBADFAMILY'\x2C\x0d\n  BADRESP: 'EBADRESP'\x2C\x0d\n  CONNREFUSED: 'ECONNREFUSED'\x2C\x0d\n  TIMEOUT: 'ETIMEOUT'\x2C\x0d\n  EOF: 'EOF'\x2C\x0d\n  FILE: 'EFILE'\x2C\x0d\n  NOMEM: 'ENOMEM'\x2C\x0d\n  DESTRUCTION: 'EDESTRUCTION'\x2C\x0d\n  BADSTR: 'EBADSTR'\x2C\x0d\n  BADFLAGS: 'EBADFLAGS'\x2C\x0d\n  NONAME: 'ENONAME'\x2C\x0d\n  BADHINTS: 'EBADHINTS'\x2C\x0d\n  NOTINITIALIZED: 'ENOTINITIALIZED'\x2C\x0d\n  LOADIPHLPAPI: 'ELOADIPHLPAPI'\x2C\x0d\n  ADDRGETNETWORKPARAMS: 'EADDRGETNETWORKPARAMS'\x2C\x0d\n  CANCELLED: 'ECANCELLED'\x0d\n};\x0d\n\x0d\nbindDefaultResolver(module.exports\x2C getDefaultResolver());\x0d\n\x0d\nObjectDefineProperties(module.exports\x2C {\x0d\n  promises: {\x0d\n    configurable: true\x2C\x0d\n    enumerable: true\x2C\x0d\n    get() {\x0d\n      if (promises === null) {\x0d\n        promises = require('internal/dns/promises');\x0d\n        promises.setServers = defaultResolverSetServers;\x0d\n        promises.setDefaultResultOrder = setDefaultResultOrder;\x0d\n      }\x0d\n      return promises;\x0d\n    }\x0d\n  }\x0d\n});\x0d\n
