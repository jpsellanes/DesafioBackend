script-source,513,C:\\Users\\sella\\Desktop\\Programacion\\CoderHouse\\Backend\\Desafio14\\node_modules\\winston\\lib\\winston\\logger.js,/**\x0d\n * logger.js: TODO: add file header description.\x0d\n *\x0d\n * (C) 2010 Charlie Robbins\x0d\n * MIT LICENCE\x0d\n */\x0d\n\x0d\n'use strict';\x0d\n\x0d\nconst { Stream\x2C Transform } = require('readable-stream');\x0d\nconst asyncForEach = require('async/forEach');\x0d\nconst { LEVEL\x2C SPLAT } = require('triple-beam');\x0d\nconst isStream = require('is-stream');\x0d\nconst ExceptionHandler = require('./exception-handler');\x0d\nconst RejectionHandler = require('./rejection-handler');\x0d\nconst LegacyTransportStream = require('winston-transport/legacy');\x0d\nconst Profiler = require('./profiler');\x0d\nconst { warn } = require('./common');\x0d\nconst config = require('./config');\x0d\n\x0d\n/**\x0d\n * Captures the number of format (i.e. %s strings) in a given string.\x0d\n * Based on `util.format`\x2C see Node.js source:\x0d\n * https://github.com/nodejs/node/blob/b1c8f15c5f169e021f7c46eb7b219de95fe97603/lib/util.js#L201-L230\x0d\n * @type {RegExp}\x0d\n */\x0d\nconst formatRegExp = /%[scdjifoO%]/g;\x0d\n\x0d\n/**\x0d\n * TODO: add class description.\x0d\n * @type {Logger}\x0d\n * @extends {Transform}\x0d\n */\x0d\nclass Logger extends Transform {\x0d\n  /**\x0d\n   * Constructor function for the Logger object responsible for persisting log\x0d\n   * messages and metadata to one or more transports.\x0d\n   * @param {!Object} options - foo\x0d\n   */\x0d\n  constructor(options) {\x0d\n    super({ objectMode: true });\x0d\n    this.configure(options);\x0d\n  }\x0d\n\x0d\n  child(defaultRequestMetadata) {\x0d\n    const logger = this;\x0d\n    return Object.create(logger\x2C {\x0d\n      write: {\x0d\n        value: function (info) {\x0d\n          const infoClone = Object.assign(\x0d\n            {}\x2C\x0d\n            defaultRequestMetadata\x2C\x0d\n            info\x0d\n          );\x0d\n\x0d\n          // Object.a