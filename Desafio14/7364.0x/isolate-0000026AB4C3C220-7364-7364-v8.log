script-source,150,C:\\Users\\sella\\Desktop\\Programacion\\CoderHouse\\Backend\\Desafio14\\server.js,const express = require("express")\x0d\nconst session = require("express-session")\x0d\nconst MongoStore = require("connect-mongo")\x0d\n//--------\x0d\nconst passport = require("passport")\x0d\nconst {Strategy: LocalStrategy} = require("passport-local")\x0d\n//------desafio 14 --------\x0d\nconst compression = require('compression')\x0d\nconst logger = require('./utils/logger.js')\x0d\n//------desafio 13 --------\x0d\nconst cluster = require("cluster")\x0d\nconst os = require("os")\x0d\n/// DESAFIO 12 ------\x0d\n//Fork\x0d\nconst {fork} = require('child_process')\x0d\nconst path = require('path')\x0d\n// ENV y CONFIG\x0d\nconst parseArgs = require('minimist')\x0d\nconst dotenv = require('dotenv').config()\x0d\n//const yargs = parseArgs(process.argv.slice(2))\x0d\nconst options = {\x0d\n    alias: {p:'puerto'\x2C m: 'modo'}\x2C\x0d\n    default:{puerto:8080\x2C modo:'fork'}\x0d\n}\x0d\n\x0d\nconst {puerto} = parseArgs(process.argv.slice(2)\x2Coptions)\x0d\nconst {modo} = parseArgs(process.argv.slice(3)\x2Coptions)\x0d\nconst debug = process.env.DEBUG == "true" ? true : false\x0d\n\x0d\nconsole.log({modo\x2C puerto\x2C debug})\x0d\n/// DESAFIO 13 SERVIDORES CLUSTER Y FORK\x0d\nif((modo =='cluster') && cluster.isPrimary){\x0d\n    const numCPUs = os.cpus().length\x0d\n    for(let i =0; i<numCPUs; i++){\x0d\n        cluster.fork()\x0d\n    }\x0d\n    cluster.on('exit'\x2C worker=>{logger.info('Worker '+ process.pid + ' ended')\x0d\n    cluster.fork()\x0d\n    })\x0d\n} else {\x0d\n//\x0d\nconst {Router} = express\x0d\nconst contenedor = require('./main.js')\x0d\nconst Newcontenedor = new contenedor('productos.json')\x0d\nconst app = express()\x0d\nconst advancedOptions = {useNewUrlParser: true\x2C useUnifiedTopology: true}\x0d\nconst userContenedor = require('./utils/contenedorUsers')\x0d\nconst newUserContenedor = new userContenedor\x0d\n\x0d\n\x0d\n////PassPort\x0d\nconst usuarios = newUserContenedor.getUser()\x0d\n\x0d\npassport.use('register'\x2C new LocalStrategy({\x0d\n    passReqToCallback: true}\x2C async(req\x2C username\x2C password\x2C done)=>{\x0d\n        const usuarios = await newUserContenedor.getUser()\x0d\n        const usuario = usuarios.filter(usuario => {return usuario.username == username})\x0d\n        //const usuario = usuarios.find(usuario => usuario.username == username)\x0d\n        if(usuario.length != 0){\x0d\n            return done('Usuario ya registrado')\x0d\n        }\x0d\n        const user = {\x0d\n            username\x2C\x0d\n            password\x2C\x0d\n        }\x0d\n        usuarios.push(user)\x0d\n        newUserContenedor.saveUser(user)\x0d\n        return done(null\x2C user)\x0d\n    }\x0d\n    ))\x0d\n//----------------\x0d\n// Passport Login\x0d\n\x0d\npassport.use('login'\x2C new LocalStrategy(async(username\x2C password\x2C done)=>{\x0d\n    const usuarios = await newUserContenedor.getUser()\x0d\n    const user = usuarios.filter(usuario => {return usuario.username == username})\x0d\n    ///console.log(user[0].password)\x0d\n    if(!user){\x0d\n        logger.error("User Not Found")\x0d\n        return done(null\x2C false)\x0d\n    }\x0d\n    if(user[0].password != password){\x0d\n        logger.error("Wrong Password")\x0d\n        return done(null\x2C false)\x0d\n    }\x0d\n    return done(null\x2C user)\x0d\n}))\x0d\n\x0d\n//Serializar\x2C y deserializar\x0d\npassport.serializeUser(function(user\x2C done){\x0d\n    done(null\x2C user[0].username)\x0d\n})\x0d\npassport.deserializeUser(async function(username\x2C done){\x0d\n    const usuarios = await newUserContenedor.getUser()\x0d\n    const usuario = usuarios.filter(usuario => usuario.username == username)\x0d\n    done(null\x2C usuario)\x0d\n})\x0d\n\x0d\n\x0d\n//APP\x0d\napp.use(express.static("public"))\x0d\napp.use(express.urlencoded({ extended: true }))\x0d\napp.use(express.json())\x0d\napp.set('view engine'\x2C 'ejs')\x0d\napp.use(\x0d\n    session({\x0d\n        store: MongoStore.create({\x0d\n            mongoUrl:'mongodb+srv://coderhouse:coderhouse@cluster0.wbfib.mongodb.net/?retryWrites=true&w=majority'\x2C\x0d\n            mongoOptions: advancedOptions\x2C\x0d\n            ttl: 600\x2C\x0d\n        })\x2C\x0d\n        secret: "secret"\x2C\x0d\n        resave: false\x2C\x0d\n        saveUninitialized: false\x2C\x0d\n        cookie:{\x0d\n            maxAge: 60000\x0d\n        }\x0d\n    })\x0d\n)\x0d\n/// Middleware de Passport\x0d\napp.use(passport.initialize())\x0d\napp.use(passport.session())\x0d\n\x0d\n\x0d\nfunction isAuth(req\x2C res\x2C next){\x0d\n    if(req.isAuthenticated()){\x0d\n        next()\x0d\n    } else {\x0d\n        res.redirect('/login')\x0d\n    }\x0d\n}\x0d\n\x0d\n//Router\x0d\n\x0d\nconst routerProductos = new Router()\x0d\nrouterProductos.get('/main'\x2C isAuth \x2Casync(req\x2C res)=>{\x0d\n    const username = req.session.nombre\x0d\n    productos = await Newcontenedor.getAll()\x0d\n    res.render('inicio'\x2C {productos\x2C username})\x0d\n})\x0d\nrouterProductos.post('/productos'\x2CisAuth\x2C async(req\x2C res)=>{\x0d\n    await Newcontenedor.save(req.body)\x0d\n    productos.push(req.body)\x0d\n    res.redirect('/main')\x0d\n})\x0d\nrouterProductos.get('/productos'\x2CisAuth \x2Casync(req\x2C res)=>{\x0d\n    productos = await Newcontenedor.getAll()\x0d\n    res.render('productos'\x2C {productos}) \x0d\n})\x0d\n\x0d\n///Registro\x0d\napp.get('/register'\x2C (req\x2C res)=>{\x0d\n    res.render("register")\x0d\n})\x0d\napp.post('/register'\x2Cpassport.authenticate('register'\x2C{failureMessage: "Auth Error"\x2C successRedirect:'/login'}))\x0d\n\x0d\n\x0d\n///Login\x0d\nrouterProductos.get('/login'\x2C async(req\x2C res)=>{\x0d\n    res.render("login")\x0d\n})\x0d\n\x0d\nrouterProductos.post('/login'\x2C async(req\x2C res\x2C next)=>{\x0d\n    const username = req.body.username\x0d\n    req.session.nombre = username\x0d\n    logger.info(req.session.nombre)\x0d\n    next()\x0d\n}\x2Cpassport.authenticate('login'\x2C {failureMessage: "Problem Loggin In"\x2C successRedirect: '/main'}))\x0d\n\x0d\nrouterProductos.get('/logout'\x2C async(req\x2Cres)=>{\x0d\n    req.session.destroy(err=>{\x0d\n        if(err){\x0d\n            res.json({error: "Log Out"\x2C descripcion: err})\x0d\n        } else {\x0d\n            res.redirect('/login')\x0d\n        }\x0d\n    })\x0d\n})\x0d\n\x0d\n// Info desafio 12\x0d\n// DESAFIO 12 /INFO \x0d\n\x0d\nconst args = process.argv\x0d\nconst pid = process.pid\x0d\nconst processPlatform = process.platform\x0d\nconst nodeVersion = process.version\x0d\nconst pMemory = process.memoryUsage.rss()\x0d\nconst pPath = process.execPath\x0d\n/////Project folder?\x0d\n\x0d\nrouterProductos.get('/info'\x2C async(req\x2C res)=>{\x0d\n    const datos = { pid\x2C args\x2C processPlatform\x2C nodeVersion\x2C pMemory\x2C pPath}\x0d\n    logger.info(datos)\x0d\n    res.send(datos)\x0d\n})\x0d\n\x0d\nrouterProductos.get('/infobloq'\x2C async(req\x2C res)=>{\x0d\n    const datos = { pid\x2C args\x2C processPlatform\x2C nodeVersion\x2C pMemory\x2C pPath}\x0d\n    console.log(datos)\x0d\n    res.send(datos)\x0d\n})\x0d\n\x0d\nrouterProductos.get('/infozip'\x2C compression()\x2C(req\x2C res)=>{\x0d\n    const datos = { pid\x2C args\x2C processPlatform\x2C nodeVersion\x2C pMemory\x2C pPath}\x0d\n    logger.info(datos)\x0d\n    res.send(datos)\x0d\n\x0d\n})\x0d\n\x0d\n// Randoms\x0d\nrouterProductos.get('/randoms'\x2C (req\x2C res)=>{\x0d\n    const numToCalc = req.query.cant || 1000000;\x0d\n    const computo = fork(path.resolve(process.cwd()\x2C 'computo.js'))\x0d\n    computo.on('message'\x2C resultado =>{\x0d\n        if(resultado === 'listo'){\x0d\n            //computo.send('start')\x0d\n            computo.send(numToCalc)\x0d\n        } else {\x0d\n            res.json({resultado})\x0d\n        }\x0d\n    })\x0d\n\x0d\n})\x0d\n\x0d\nrouterProductos.get('/randomszip'\x2C compression()\x2C(req\x2C res)=>{\x0d\n    const numToCalc = req.query.cant || 1000000;\x0d\n    const computo = fork(path.resolve(process.cwd()\x2C 'computo.js'))\x0d\n    computo.on('message'\x2C resultado =>{\x0d\n        if(resultado === 'listo'){\x0d\n            //computo.send('start')\x0d\n            computo.send(numToCalc)\x0d\n        } else {\x0d\n            res.json({resultado})\x0d\n        }\x0d\n    })\x0d\n\x0d\n})\x0d\n\x0d\n\x0d\n// Carga de router\x0d\napp.use("/"\x2C routerProductos)\x0d\n\x0d\n//Levantar Server\x0d\nconst server = app.listen(puerto\x2C ()=>{\x0d\n    logger.info(`servidor escuchando ${server.address().port}`)\x0d\n})\x0d\nserver.on("error"\x2C error => console.log("error" + error))\x0d\n\x0d\n}\x0d\n
