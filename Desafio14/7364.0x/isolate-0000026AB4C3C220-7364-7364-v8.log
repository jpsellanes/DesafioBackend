module destroyed\x2C they will call\x0d\n    // `this._handle.close()` which will also emit EOF if not emitted before.\x0d\n    // This feature makes sockets on the other side emit "end" and "close"\x0d\n    // even though we haven't called `end()`. As `stream` are likely to be\x0d\n    // instances of `net.Socket`\x2C calling `stream.destroy()` manually will\x0d\n    // avoid issues that don't properly close wrapped connections.\x0d\n    this.stream.destroy();\x0d\n\x0d\n    setImmediate(() => {\x0d\n      // Should be already set by net.js\x0d\n      assert(this._handle === null);\x0d\n\x0d\n      this.finishWrite(handle\x2C uv.UV_ECANCELED);\x0d\n      this.finishShutdown(handle\x2C uv.UV_ECANCELED);\x0d\n\x0d\n      cb();\x0d\n    });\x0d\n  }\x0d\n}\x0d\n\x0d\nmodule.exports = JSStreamSocket;\x0d\n
