 !== undefined)\x0d\n    this.privateKeyIdentifier = options.privateKeyIdentifier;\x0d\n  if (options.privateKeyEngine !== undefined)\x0d\n    this.privateKeyEngine = options.privateKeyEngine;\x0d\n}\x2C 'Server.prototype.setOptions() is deprecated'\x2C 'DEP0122');\x0d\n\x0d\n// SNI Contexts High-Level API\x0d\nServer.prototype.addContext = function(servername\x2C context) {\x0d\n  if (!servername) {\x0d\n    throw new ERR_TLS_REQUIRED_SERVER_NAME();\x0d\n  }\x0d\n\x0d\n  const re = new RegExp('^' + StringPrototypeReplace(\x0d\n    StringPrototypeReplace(servername\x2C /([.^$+?\\-\\\\[\\]{}])/g\x2C '\\\\$1')\x2C\x0d\n    /\\*/g\x2C '[^.]*'\x0d\n  ) + '$');\x0d\n  ArrayPrototypePush(this._contexts\x2C\x0d\n                     [re\x2C tls.createSecureContext(context).context]);\x0d\n};\x0d\n\x0d\nServer.prototype[EE.captureRejectionSymbol] = function(\x0d\n  err\x2C event\x2C sock) {\x0d\n\x0d\n  switch (event) {\x0d\n    case 'secureConnection':\x0d\n      sock.destroy(err);\x0d\n      break;\x0d\n    default:\x0d\n      ReflectApply(net.Server.prototype[SymbolFor('nodejs.rejection')]\x2C this\x2C\x0d\n                   [err\x2C event\x2C sock]);\x0d\n  }\x0d\n};\x0d\n\x0d\nfunction SNICallback(servername\x2C callback) {\x0d\n  const contexts = this.server._contexts;\x0d\n\x0d\n  for (let i = contexts.length - 1; i >= 0; --i) {\x0d\n    const elem = contexts[i];\x0d\n    if (RegExpPrototypeTest(elem[0]\x2C servername)) {\x0d\n      callback(null\x2C elem[1]);\x0d\n      return;\x0d\n    }\x0d\n  }\x0d\n\x0d\n  callback(null\x2C undefined);\x0d\n}\x0d\n\x0d\n\x0d\n// Target API:\x0d\n//\x0d\n//  let s = tls.connect({port: 8000\x2C host: "google.com"}\x2C function() {\x0d\n//    if (!s.authorized) {\x0d\n//      s.destroy();\x0d\n//      return;\x0d\n//    }\x0d\n//\x0d\n//    // s.socket;\x0d\n//\x0d\n//    s.end("hello world\\n");\x0d\n//  });\x0d\n//\x0d\n//\x0d\nfunction normalizeConnectArgs(listArgs) {\x0d\n  const args = net._normalizeArgs(listArgs);\x0d\n  const options = args[0];\x0d\n  const cb = args[1];\x0d\n\x0d\n  // If args[0] was options\x2C then normalize dealt with it.\x0d\n  // If args[0] is port\x2C or args[0]\x2C args[1] is host\x2C port\x2C we need to\x0d\n  // find the options and merge them in\x2C normalize's options has only\x0d\n  // the host/port/path args that it knows about\x2C not the tls options.\x0d\n  // This means that options.host overrides a host arg.\x0d\n  if (listArgs[1] !== null && typeof listArgs[1] === 'object') {\x0d\n    ObjectAssign(options\x2C listArgs[1]);\x0d\n  } else if (listArgs[2] !== null && typeof listArgs[2] === 'object') {\x0d\n    ObjectAssign(options\x2C listArgs[2]);\x0d\n  }\x0d\n\x0d\n  return cb ? [options\x2C cb] : [options];\x0d\n}\x0d\n\x0d\nfunction onConnectSecure() {\x0d\n  const options = this[kConnectOptions];\x0d\n\x0d\n  // Check the size of DHE parameter above minimum requirement\x0d\n  // specified in options.\x0d\n  const ekeyinfo = this.getEphemeralKeyInfo();\x0d\n  if (ekeyinfo.type === 'DH' && ekeyinfo.size < options.minDHSize) {\x0d\n    const err = new ERR_TLS_DH_PARAM_SIZE(ekeyinfo.size);\x0d\n    debug('client emit:'\x2C err);\x0d\n    this.emit('error'\x2C err);\x0d\n    this.destroy();\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  let verifyError = this._handle.verifyError();\x0d\n\x0d\n  // Verify that server's identity matches it's certificate's names\x0d\n  // Unless server has resumed our existing session\x0d\n  if (!verifyError && !this.isSessionReused()) {\x0d\n    const hostname = options.servername ||\x0d\n                   options.host ||\x0d\n                   (options.socket && options.socket._host) ||\x0d\n                   'localhost';\x0d\n    const cert = this.getPeerCertificate(true);\x0d\n    verifyError = options.checkServerIdentity(hostname\x2C cert);\x0d\n  }\x0d\n\x0d\n  if (verifyError) {\x0d\n    this.authorized = false;\x0d\n    this.authorizationError = verifyError.code || verifyError.message;\x0d\n\x0d\n    // rejectUnauthorized property can be explicitly defined as `undefined`\x0d\n    // causing the assignment to default value (`true`) fail. Before assigning\x0d\n    // it to the tlssock connection options\x2C explicitly check if it is false\x0d\n    // and update rejectUnauthorized property. The property gets used by\x0d\n    // TLSSocket connection handler to allow or reject connection if\x0d\n    // unauthorized.\x0d\n    // This check is potentially redundant\x2C however it is better to keep it\x0d\n    // in case the option object gets modified somewhere.\x0d\n    if (options.rejectUnauthorized !== false) {\x0d\n      this.destroy(verifyError);\x0d\n      return;\x0d\n    }\x0d\n    debug('client emit secureConnect. rejectUnauthorized: %s\x2C ' +\x0d\n          'authorizationError: %s'\x2C options.rejectUnauthorized\x2C\x0d\n          this.authorizationError);\x0d\n    this.secureConnecting = false;\x0d\n    this.emit('secureConnect');\x0d\n  } else {\x0d\n    this.authorized = true;\x0d\n    debug('client emit secureConnect. authorized:'\x2C this.authorized);\x0d\n    this.secureConnecting = false;\x0d\n    this.emit('secureConnect');\x0d\n  }\x0d\n\x0d\n  this[kIsVerified] = true;\x0d\n  const session = this[kPendingSession];\x0d\n  this[kPendingSession] = null;\x0d\n  if (session)\x0d\n    this.emit('session'\x2C session);\x0d\n\x0d\n  this.removeListener('end'\x2C onConnectEnd);\x0d\n}\x0d\n\x0d\nfunction onConnectEnd() {\x0d\n  // NOTE: This logic is shared with _http_client.js\x0d\n  if (!this._hadError) {\x0d\n    const options = this[kConnectOptions];\x0d\n    this._hadError = true;\x0d\n    const error = connResetException('Client network socket disconnected ' +\x0d\n                                     'before secure TLS connection was ' +\x0d\n                                     'established');\x0d\n    error.path = options.path;\x0d\n    error.host = options.host;\x0d\n    error.port = options.port;\x0d\n    error.localAddress = options.localAddress;\x0d\n    this.destroy(error);\x0d\n  }\x0d\n}\x0d\n\x0d\n// Arguments: [port\x2C] [host\x2C] [options\x2C] [cb]\x0d\nexports.connect = function connect(...args) {\x0d\n  args = normalizeConnectArgs(args);\x0d\n  let options = args[0];\x0d\n  const cb = args[1];\x0d\n  const allowUnauthorized = getAllowUnauthorized();\x0d\n\x0d\n  options = {\x0d\n    rejectUnauthorized: !allowUnauthorized\x2C\x0d\n    ciphers: tls.DEFAULT_CIPHERS\x2C\x0d\n    checkServerIdentity: tls.checkServerIdentity\x2C\x0d\n    minDHSize: 1024\x2C\x0d\n    ...options\x0d\n  };\x0d\n\x0d\n  if (!options.keepAlive)\x0d\n    options.singleUse = true;\x0d\n\x0d\n  assert(typeof options.checkServerIdentity === 'function');\x0d\n  assert(typeof options.minDHSize === 'number'\x2C\x0d\n         'options.minDHSize is not a number: ' + options.minDHSize);\x0d\n  assert(options.minDHSize > 0\x2C\x0d\n         'options.minDHSize is not a positive number: ' +\x0d\n         options.minDHSize);\x0d\n\x0d\n  const context = options.secureContext || tls.createSecureContext(options);\x0d\n\x0d\n  const tlssock = new TLSSocket(options.socket\x2C {\x0d\n    allowHalfOpen: options.allowHalfOpen\x2C\x0d\n    pipe: !!options.path\x2C\x0d\n    secureContext: context\x2C\x0d\n    isServer: false\x2C\x0d\n    requestCert: true\x2C\x0d\n    rejectUnauthorized: options.rejectUnauthorized !== false\x2C\x0d\n    session: options.session\x2C\x0d\n    ALPNProtocols: options.ALPNProtocols\x2C\x0d\n    requestOCSP: options.requestOCSP\x2C\x0d\n    enableTrace: options.enableTrace\x2C\x0d\n    pskCallback: options.pskCallback\x2C\x0d\n    highWaterMark: options.highWaterMark\x2C\x0d\n    onread: options.onread\x2C\x0d\n    signal: options.signal\x2C\x0d\n  });\x0d\n\x0d\n  // rejectUnauthorized property can be explicitly defined as `undefined`\x0d\n  // causing the assignment to default value (`true`) fail. Before assigning\x0d\n  // it to the tlssock connection options\x2C explicitly check if it is false\x0d\n  // and update rejectUnauthorized property. The property gets used by TLSSocket\x0d\n  // connection handler to allow or reject connection if unauthorized\x0d\n  options.rejectUnauthorized = options.rejectUnauthorized !== false;\x0d\n\x0d\n  tlssock[kConnectOptions] = options;\x0d\n\x0d\n  if (cb)\x0d\n    tlssock.once('secureConnect'\x2C cb);\x0d\n\x0d\n  if (!options.socket) {\x0d\n    // If user provided the socket\x2C it's their responsibility to manage its\x0d\n    // connectivity. If we created one internally\x2C we connect it.\x0d\n    if (options.timeout) {\x0d\n      tlssock.setTimeout(options.timeout);\x0d\n    }\x0d\n\x0d\n    tlssock.connect(options\x2C tlssock._start);\x0d\n  }\x0d\n\x0d\n  tlssock._releaseControl();\x0d\n\x0d\n  if (options.session)\x0d\n    tlssock.setSession(options.session);\x0d\n\x0d\n  if (options.servername) {\x0d\n    if (!ipServernameWarned && net.isIP(options.servername)) {\x0d\n      process.emitWarning(\x0d\n        'Setting the TLS ServerName to an IP address is not permitted by ' +\x0d\n        'RFC 6066. This will be ignored in a future version.'\x2C\x0d\n        'DeprecationWarning'\x2C\x0d\n        'DEP0123'\x0d\n      );\x0d\n      ipServernameWarned = true;\x0d\n    }\x0d\n    tlssock.setServername(options.servername);\x0d\n  }\x0d\n\x0d\n  if (options.socket)\x0d\n    tlssock._start();\x0d\n\x0d\n  tlssock.on('secure'\x2C onConnectSecure);\x0d\n  tlssock.prependListener('end'\x2C onConnectEnd);\x0d\n\x0d\n  return tlssock;\x0d\n};\x0d\n
