script-source,435,node:internal/tls/parse-cert-string,'use strict';\x0d\n\x0d\nconst {\x0d\n  ArrayIsArray\x2C\x0d\n  ArrayPrototypeForEach\x2C\x0d\n  ArrayPrototypePush\x2C\x0d\n  StringPrototypeIndexOf\x2C\x0d\n  StringPrototypeSlice\x2C\x0d\n  StringPrototypeSplit\x2C\x0d\n  ObjectCreate\x2C\x0d\n} = primordials;\x0d\n\x0d\n// Example:\x0d\n// C=US\\nST=CA\\nL=SF\\nO=Joyent\\nOU=Node.js\\nCN=ca1\\nemailAddress=ry@clouds.org\x0d\nfunction parseCertString(s) {\x0d\n  const out = ObjectCreate(null);\x0d\n  ArrayPrototypeForEach(StringPrototypeSplit(s\x2C '\\n')\x2C (part) => {\x0d\n    const sepIndex = StringPrototypeIndexOf(part\x2C '=');\x0d\n    if (sepIndex > 0) {\x0d\n      const key = StringPrototypeSlice(part\x2C 0\x2C sepIndex);\x0d\n      const value = StringPrototypeSlice(part\x2C sepIndex + 1);\x0d\n      if (key in out) {\x0d\n        if (!ArrayIsArray(out[key])) {\x0d\n          out[key] = [out[key]];\x0d\n        }\x0d\n        ArrayPrototypePush(out[key]\x2C value);\x0d\n      } else {\x0d\n        out[key] = value;\x0d\n      }\x0d\n    }\x0d\n  });\x0d\n  return out;\x0d\n}\x0d\n\x0d\nexports.parseCertString = parseCertString;\x0d\n
