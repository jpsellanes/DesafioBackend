script-source,770,C:\\Users\\sella\\Desktop\\Programacion\\CoderHouse\\Backend\\Desafio14\\node_modules\\mongoose\\lib\\helpers\\query\\completeMany.js,'use strict';\n\nconst helpers = require('../../queryhelpers');\nconst immediate = require('../immediate');\n\nmodule.exports = completeMany;\n\n/*!\n * Given a model and an array of docs\x2C hydrates all the docs to be instances\n * of the model. Used to initialize docs returned from the db from `find()`\n *\n * @param {Model} model\n * @param {Array} docs\n * @param {Object} fields the projection used\x2C including `select` from schemas\n * @param {Object} userProvidedFields the user-specified projection\n * @param {Object} opts\n * @param {Array} [opts.populated]\n * @param {ClientSession} [opts.session]\n * @param {Function} callback\n */\n\nfunction completeMany(model\x2C docs\x2C fields\x2C userProvidedFields\x2C opts\x2C callback) {\n  const arr = [];\n  let count = docs.length;\n  const len = count;\n  let error = null;\n\n  function init(_error) {\n    if (_error != null) {\n      error = error || _error;\n    }\n    if (error != null) {\n      --count || immediate(() => callback(error));\n      return;\n    }\n    --count || immediate(() => callback(error\x2C arr));\n  }\n\n  for (let i = 0; i < len; ++i) {\n    arr[i] = helpers.createModel(model\x2C docs[i]\x2C fields\x2C userProvidedFields);\n    try {\n      arr[i].$init(docs[i]\x2C opts\x2C init);\n    } catch (error) {\n      init(error);\n    }\n\n    if (opts.session != null) {\n      arr[i].$session(opts.session);\n    }\n  }\n}\n
