age multiple `winston.Logger` instances without any\x0d\n * additional overhead.\x0d\n * @example\x0d\n *   // some-file1.js\x0d\n *   const logger = require('winston').loggers.get('something');\x0d\n *\x0d\n *   // some-file2.js\x0d\n *   const logger = require('winston').loggers.get('something');\x0d\n */\x0d\nexports.loggers = new exports.Container();\x0d\n\x0d\n/**\x0d\n * We create and expose a 'defaultLogger' so that the programmer may do the\x0d\n * following without the need to create an instance of winston.Logger directly:\x0d\n * @example\x0d\n *   const winston = require('winston');\x0d\n *   winston.log('info'\x2C 'some message');\x0d\n *   winston.error('some error');\x0d\n */\x0d\nconst defaultLogger = exports.createLogger();\x0d\n\x0d\n// Pass through the target methods onto `winston.\x0d\nObject.keys(exports.config.npm.levels)\x0d\n  .concat([\x0d\n    'log'\x2C\x0d\n    'query'\x2C\x0d\n    'stream'\x2C\x0d\n    'add'\x2C\x0d\n    'remove'\x2C\x0d\n    'clear'\x2C\x0d\n    'profile'\x2C\x0d\n    'startTimer'\x2C\x0d\n    'handleExceptions'\x2C\x0d\n    'unhandleExceptions'\x2C\x0d\n    'handleRejections'\x2C\x0d\n    'unhandleRejections'\x2C\x0d\n    'configure'\x2C\x0d\n    'child'\x0d\n  ])\x0d\n  .forEach(\x0d\n    method => (exports[method] = (...args) => defaultLogger[method](...args))\x0d\n  );\x0d\n\x0d\n/**\x0d\n * Define getter / setter for the default logger level which need to be exposed\x0d\n * by winston.\x0d\n * @type {string}\x0d\n */\x0d\nObject.defineProperty(exports\x2C 'level'\x2C {\x0d\n  get() {\x0d\n    return defaultLogger.level;\x0d\n  }\x2C\x0d\n  set(val) {\x0d\n    defaultLogger.level = val;\x0d\n  }\x0d\n});\x0d\n\x0d\n/**\x0d\n * Define getter for `exceptions` which replaces `handleExceptions` and\x0d\n * `unhandleExceptions`.\x0d\n * @type {Object}\x0d\n */\x0d\nObject.defineProperty(exports\x2C 'exceptions'\x2C {\x0d\n  get() {\x0d\n    return defaultLogger.exceptions;\x0d\n  }\x0d\n});\x0d\n\x0d\n/**\x0d\n * Define ge