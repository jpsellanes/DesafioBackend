\n\x09\x09function debug(...args) {\n\x09\x09\x09// Disabled?\n\x09\x09\x09if (!debug.enabled) {\n\x09\x09\x09\x09return;\n\x09\x09\x09}\n\n\x09\x09\x09const self = debug;\n\n\x09\x09\x09// Set `diff` timestamp\n\x09\x09\x09const curr = Number(new Date());\n\x09\x09\x09const ms = curr - (prevTime || curr);\n\x09\x09\x09self.diff = ms;\n\x09\x09\x09self.prev = prevTime;\n\x09\x09\x09self.curr = curr;\n\x09\x09\x09prevTime = curr;\n\n\x09\x09\x09args[0] = createDebug.coerce(args[0]);\n\n\x09\x09\x09if (typeof args[0] !== 'string') {\n\x09\x09\x09\x09// Anything else let's inspect with %O\n\x09\x09\x09\x09args.unshift('%O');\n\x09\x09\x09}\n\n\x09\x09\x09// Apply any `formatters` transformations\n\x09\x09\x09let index = 0;\n\x09\x09\x09args[0] = args[0].replace(/%([a-zA-Z%])/g\x2C (match\x2C format) => {\n\x09\x09\x09\x09// If we encounter an escaped % then don't increase the array index\n\x09\x09\x09\x09if (match === '%%') {\n\x09\x09\x09\x09\x09return '%';\n\x09\x09\x09\x09}\n\x09\x09\x09\x09index++;\n\x09\x09\x09\x09const formatter = createDebug.formatters[format];\n\x09\x09\x09\x09if (typeof formatter === 'function') {\n\x09\x09\x09\x09\x09const val = args[index];\n\x09\x09\x09\x09\x09match = formatter.call(self\x2C val);\n\n\x09\x09\x09\x09\x09// Now we need to remove `args[index]` since it's inlined in the `format`\n\x09\x09\x09\x09\x09args.splice(index\x2C 1);\n\x09\x09\x09\x09\x09index--;\n\x09\x09\x09\x09}\n\x09\x09\x09\x09return match;\n\x09\x09\x09});\n\n\x09\x09\x09// Apply env-specific formatting (colors\x2C etc.)\n\x09\x09\x09createDebug.formatArgs.call(self\x2C args);\n\n\x09\x09\x09const logFn = self.log || createDebug.log;\n\x09\x09\x09logFn.apply(self\x2C args);\n\x09\x09}\n\n\x09\x09debug.namespace = namespace;\n\x09\x09debug.useColors = createDebug.useColors();\n\x09\x09debug.color = createDebug.selectColor(namespace);\n\x09\x09debug.extend = extend;\n\x09\x09debug.destroy = createDebug.destroy; // XXX Temporary. Will be removed in the next major release.\n\n\x09\x09Object.defineProperty(debug\x2C 'enabled'\x2C {\n\x09\x09\x09enumerable: true\x2C\n\x09\x09\x09configurable: false\x2C\n\x09\x09\x09get: () => {\n\x09\x09\x09\x09if (enableOverride !== null) {\n\x09\x09\x09\x09\x09return enableOverride;\n\x09\x09\x09\x09}\n\x09\x09\x09\x09if (namespacesCache !== createDebug.namespaces) {\n\x09\x09\x09\x09\x09namespacesCache = createDebug.namespaces;\n\x09\x09\x09\x09\x09enabledCache = createDebug.enabled(namespace);\n\x09\x09\x09\x09}\n\n\x09\x09\x09\x09return enabledCache;\n\x09\x09\x09}\x2C\n\x09\x09\x09set: v => {\n\x09\x09\x09\x09enableOverride = v;\n\x09\x09\x09}\n\x09\x09});\n\n\x09\x09// Env-specific initialization logic for debug instances\n\x09\x09if (typeof createDebug.init === 'function') {\n\x09\x09\x09createDebug.init(debug);\n\x09\x09}\n\n\x09\x09return debug;\n\x09}\n\n\x09function extend(namespace\x2C delimiter) {\n\x09\x09const newDebug = createDebug(this.namespace + (typeof delimiter === 'undefined' ? ':' : delimiter) + namespace);\n\x09\x09newDebug.log = this.log;\n\x09\x09return newDebug;\n\x09}\n\n\x09/**\n\x09* Enables a debug mode by namespaces. This can include modes\n\x09* separated by a colon and wildcards.\n\x09*\n\x09* @param {String} namespaces\n\x09* @api public\n\x09*/\n\x09function enable(namespaces) {\n\x09\x09createDebug.save(namespaces);\n\x09\x09createDebug.namespaces = namespaces;\n\n\x09\x09createDebug.names = [];\n\x09\x09createDebug.skips = [];\n\n\x09\x09let i;\n\x09\x09const split = (typeof namespaces === 'string' ? namespaces : '').split(/[\\s\x2C]+/);\n\x09\x09const len = split.length;\n\n\x09\x09for (i = 0; i < len; i++) {\n\x09\x09\x09if (!split[i]) {\n\x09\x09\x09\x09// ignore empty strings\n\x09\x09\x09\x09continue;\n\x09\x09\x09}\n\n\x09\x09\x09namespaces = split[i].replace(/\\*/g\x2C '.*?');\n\n\x09\x09\x09if (namespaces[0] === '-') {\n\x09\x09\x09\x09createDebug.skips.push(new RegExp('^' + namespaces.slice(1) + '$'));\n\x09\x09\x09} else {\n\x09\x09\x09\x09createDebug.names.push(new RegExp('^' + namespaces + '$'));\n\x09\x09\x09}\n\x09\x09}\n\x09}\n\n\x09/**\n\x09* Disable debug output.\n\x09*\n\x09* @return {String} namespaces\n\x09* @api public\n\x09*/\n\x09function disable() {\n\x09\x09const namespaces = [\n\x09\x09\x09...createDebug.names.map(toNamespace)\x2C\n\x09\x09\x09...createDebug.skips.map(toNamespace).map(namespace => '-' + namespace)\n\x09\x09].join('\x2C');\n\x09\x09createDebug.enable('');\n\x09\x09return namespaces;\n\x09}\n\n\x09/**\n\x09* Returns true if the given mode name is enabled\x2C false otherwise.\n\x09*\n\x09* @param {String} name\n\x09* @return {Boolean}\n\x09* @api public\n\x09*/\n\x09function enabled(name) {\n\x09\x09if (name[name.length - 1] === '*') {\n\x09\x09\x09return true;\n\x09\x09}\n\n\x09\x09let i;\n\x09\x09let len;\n\n\x09\x09for (i = 0\x2C len = createDebug.skips.length; i < len; i++) {\n\x09\x09\x09if (createDebug.skips[i].test(name)) {\n\x09\x09\x09\x09return false;\n\x09\x09\x09}\n\x09\x09}\n\n\x09\x09for (i = 0\x2C len = createDebug.names.length; i < len; i++) {\n\x09\x09\x09if (createDebug.names[i].test(name)) {\n\x09\x09\x09\x09return true;\n\x09\x09\x09}\n\x09\x09}\n\n\x09\x09return false;\n\x09}\n\n\x09/**\n\x09* Convert regexp to namespace\n\x09*\n\x09* @param {RegExp} regxep\n\x09* @return {String} namespace\n\x09* @api private\n\x09*/\n\x09function toNamespace(regexp) {\n\x09\x09return regexp.toString()\n\x09\x09\x09.substring(2\x2C regexp.toString().length - 2)\n\x09\x09\x09.replace(/\\.\\*\\?$/\x2C '*');\n\x09}\n\n\x09/**\n\x09* Coerce `val`.\n\x09*\n\x09* @param {Mixed} val\n\x09* @return {Mixed}\n\x09* @api private\n\x09*/\n\x09function coerce(val) {\n\x09\x09if (val instanceof Error) {\n\x09\x09\x09return val.stack || val.message;\n\x09\x09}\n\x09\x09return val;\n\x09}\n\n\x09/**\n\x09* XXX DO NOT USE. This is a temporary stub function.\n\x09* XXX It WILL be removed in the next major release.\n\x09*/\n\x09function destroy() {\n\x09\x09console.warn('Instance method `debug