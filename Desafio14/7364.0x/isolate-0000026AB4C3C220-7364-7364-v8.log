ssert');\x0d\nconst crypto = require('crypto');\x0d\nconst EE = require('events');\x0d\nconst net = require('net');\x0d\nconst tls = require('tls');\x0d\nconst common = require('_tls_common');\x0d\nconst JSStreamSocket = require('internal/js_stream_socket');\x0d\nconst { Buffer } = require('buffer');\x0d\nlet debug = require('internal/util/debuglog').debuglog('tls'\x2C (fn) => {\x0d\n  debug = fn;\x0d\n});\x0d\nconst { TCP\x2C constants: TCPConstants } = internalBinding('tcp_wrap');\x0d\nconst tls_wrap = internalBinding('tls_wrap');\x0d\nconst { Pipe\x2C constants: PipeConstants } = internalBinding('pipe_wrap');\x0d\nconst { owner_symbol } = require('internal/async_hooks').symbols;\x0d\nconst { isArrayBufferView } = require('internal/util/types');\x0d\nconst { SecureContext: NativeSecureContext } = internalBinding('crypto');\x0d\nconst { connResetException\x2C codes } = require('internal/errors');\x0d\nconst {\x0d\n  ERR_INVALID_ARG_TYPE\x2C\x0d\n  ERR_INVALID_ARG_VALUE\x2C\x0d\n  ERR_MULTIPLE_CALLBACK\x2C\x0d\n  ERR_SOCKET_CLOSED\x2C\x0d\n  ERR_TLS_DH_PARAM_SIZE\x2C\x0d\n  ERR_TLS_HANDSHAKE_TIMEOUT\x2C\x0d\n  ERR_TLS_INVALID_CONTEXT\x2C\x0d\n  ERR_TLS_RENEGOTIATION_DISABLED\x2C\x0d\n  ERR_TLS_REQUIRED_SERVER_NAME\x2C\x0d\n  ERR_TLS_SESSION_ATTACK\x2C\x0d\n  ERR_TLS_SNI_FROM_SERVER\x2C\x0d\n  ERR_TLS_INVALID_STATE\x0d\n} = codes;\x0d\nconst { onpskexchange: kOnPskExchange } = internalBinding('symbols');\x0d\nconst {\x0d\n  getOptionValue\x2C\x0d\n  getAllowUnauthorized\x2C\x0d\n} = require('internal/options');\x0d\nconst {\x0d\n  validateBoolean\x2C\x0d\n  validateBuffer\x2C\x0d\n  validateCallback\x2C\x0d\n  validateFunction\x2C\x0d\n  validateInt32\x2C\x0d\n  validateNumber\x2C\x0d\n  validateObject\x2C\x0d\n  validateString\x2C\x0d\n  validateUint32\x2C\x0d\n} = require('internal/validators');\x0d\nconst {\x0d\n  InternalX509Certificate\x0d\n} = require('internal/crypto/x509');\x0d\nconst traceTls = getOptionValue('--trace-tls');\x0d\nconst tlsKeylog = getOptionValue('--tls-keylog');\x0d\nconst { appendFile } = require('fs');\x0d\nconst kConnectOptions = Symbol('connect-options');\x0d\nconst kDisableRenegotiation = Symbol('disable-renegotiation');\x0d\nconst kErrorEmitted = Symbol('error-emitted');\x0d\nconst kHandshakeTimeout = Symbol('handshake-timeout');\x0d\nconst kRes = Symbol('res');\x0d\nconst kSNICallback = Symbol('snicallback');\x0d\nconst kEnableTrace = Symbol('enableTrace');\x0d\nconst kPskCallback = Symbol('pskcallback');\x0d\nconst kPskIdentityHint = Symbol('pskidentityhint');\x0d\nconst kPendingSession = Symbol('pendingSession');\x0d\nconst kIsVerified = Symbol('verified');\x0d\n\x0d\nconst noop = FunctionPrototype;\x0d\n\x0d\nlet ipServernameWarned = false;\x0d\nlet tlsTracingWarned = false;\x0d\n\x0d\n// Server side times how long a handshake is taking to protect against slow\x0d\n// handshakes being used for DoS.\x0d\nfunction onhandshakestart(now) {\x0d\n  debug('server onhandshakestart');\x0d\n\x0d\n  const { lastHandshakeTime } = this;\x0d\n  assert(now >= lastHandshakeTime\x2C\x0d\n         `now (${now}) < lastHandshakeTime (${lastHandshakeTime})`);\x0d\n\x0d\n  this.lastHandshakeTime = now;\x0d\n\x0d\n  // If this is the first handshake we can skip the rest of the checks.\x0d\n  if (lastHandshakeTime === 0)\x0d\n    return;\x0d\n\x0d\n  if ((now - lastHandshakeTime) >= tls.CLIENT_RENEG_WINDOW * 1000)\x0d\n    this.handshakes = 1;\x0d\n  else\x0d\n    this.handshakes++;\x0d\n\x0d\n  const owner = this[owner_symbol];\x0d\n\x0d\n  assert(owner._tlsOptions.isServer);\x0d\n\x0d\n  if (this.handshakes > tls.CLIENT_RENEG_LIMIT) {\x0d\n    owner._emitTLSError(new ERR_TLS_SESSION_ATTACK());\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  if (owner[kDisableRenegotiation])\x0d\n    owner._emitTLSError(new ERR_TLS_RENEGOTIATION_DISABLED());\x0d\n}\x0d\n\x0d\nfunction onhandshakedone() {\x0d\n  debug('server onhandshakedone');\x0d\n\x0d\n  const owner = this[owner_symbol];\x0d\n  assert(owner._tlsOptions.isServer);\x0d\n\x0d\n  // `newSession` callback wasn't called yet\x0d\n  if (owner._newSessionPending) {\x0d\n    owner._securePending = true;\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  owner._finishInit();\x0d\n}\x0d\n\x0d\n\x0d\nfunction loadSession(hello) {\x0d\n  debug('server onclienthello'\x2C\x0d\n        'sessionid.len'\x2C hello.sessionId.length\x2C\x0d\n        'ticket?'\x2C hello.tlsTicket\x0d\n  );\x0d\n  const owner = this[owner_symbol];\x0d\n\x0d\n  let once = false;\x0d\n  function onSession(err\x2C session) {\x0d\n    debug('server resumeSession callback(err %j\x2C sess? %s)'\x2C err\x2C !!session);\x0d\n    if (once)\x0d\n      return owner.destroy(new ERR_MULTIPLE_CALLBACK());\x0d\n    once = true;\x0d\n\x0d\n    if (err)\x0d\n      return owner.destroy(err);\x0d\n\x0d\n    if (owner._handle === null)\x0d\n      return owner.destroy(new ERR_SOCKET_CLOSED());\x0d\n\x0d\n    owner._handle.loadSession(session);\x0d\n    // Session is loaded. End the parser to allow handshaking to continue.\x0d\n    owner._handle.endParser();\x0d\n  }\x0d\n\x0d\n  if (hello.sessionId.length <= 0 ||\x0d\n      hello.tlsTicket ||\x0d\n      (owner.server &&\x0d\n      !owner.server.emit('resumeSession'\x2C hello.sessionId\x2C onSession))) {\x0d\n    // Sessions without identifiers can't be resumed.\x0d\n    // Sessions with tickets can be resumed directly from the ticket\x2C no server\x0d\n    // session storage is necessary.\x0d\n    // Without a call to a resumeSession listener\x2C a session will never be\x0d\n    // loaded\x2C so end the parser to allow handshaking to continue.\x0d\n    owner._handle.endParser();\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\nfunction loadSNI(info) {\x0d\n  const owner = this[owner_symbol];\x0d\n  const servername = info.servername;\x0d\n  if (!servername || !owner._SNICallback)\x0d\n    return requestOCSP(owner\x2C info);\x0d\n\x0d\n  let once = false;\x0d\n  owner._SNICallback(servername\x2C (err\x2C context) => {\x0d\n    if (once)\x0d\n      return owner.destroy(new ERR_MULTIPLE_CALLBACK());\x0d\n    once = true;\x0d\n\x0d\n    if (err)\x0d\n      return owner.destroy(err);\x0d\n\x0d\n    if (owner._handle === null)\x0d\n      return owner.destroy(new ERR_SOCKET_CLOSED());\x0d\n\x0d\n    // TODO(indutny): eventually disallow raw `SecureContext`\x0d\n    if (context)\x0d\n      owner._handle.sni_context = context.context || context;\x0d\n\x0d\n    requestOCSP(owner\x2C info);\x0d\n  });\x0d\n}\x0d\n\x0d\n\x0d\nfunction requestOCSP(socket\x2C info) {\x0d\n  if (!info.OCSPRequest || !socket.server)\x0d\n    return requestOCSPDone(socket);\x0d\n\x0d\n  let ctx = socket._handle.sni_context;\x0d\n\x0d\n  if (!ctx) {\x0d\n    ctx = socket.server._sharedCreds;\x0d\n\x0d\n    // TLS socket is using a `net.Server` instead of a tls.TLSServer.\x0d\n    // Some TLS properties like `server._sharedCreds` will not be present\x0d\n    if (!ctx)\x0d\n      return requestOCSPDone(socket);\x0d\n  }\x0d\n\x0d\n  // TODO(indutny): eventually disallow raw `SecureContext`\x0d\n  if (ctx.context)\x0d\n    ctx = ctx.context;\x0d\n\x0d\n  if (socket.server.listenerCount('OCSPRequest') === 0) {\x0d\n    return requestOCSPDone(socket);\x0d\n  }\x0d\n\x0d\n  let once = false;\x0d\n  const onOCSP = (err\x2C response) => {\x0d\n    debug('server OCSPRequest done'\x2C 'handle?'\x2C !!socket._handle\x2C 'once?'\x2C once\x2C\x0d\n          'response?'\x2C !!response\x2C 'err?'\x2C err);\x0d\n    if (once)\x0d\n      return socket.destroy(new ERR_MULTIPLE_CALLBACK());\x0d\n    once = true;\x0d\n\x0d\n    if (err)\x0d\n      return socket.destroy(err);\x0d\n\x0d\n    if (socket._handle === null)\x0d\n      return socket.destroy(new ERR_SOCKET_CLOSED());\x0d\n\x0d\n    if (response)\x0d\n      socket._handle.setOCSPResponse(response);\x0d\n    requestOCSPDone(socket);\x0d\n  };\x0d\n\x0d\n  debug('server oncertcb emit OCSPRequest');\x0d\n  socket.server.emit('OCSPRequest'\x2C\x0d\n                     ctx.getCertificate()\x2C\x0d\n                     ctx.getIssuer()\x2C\x0d\n                     onOCSP);\x0d\n}\x0d\n\x0d\nfunction requestOCSPDone(socket) {\x0d\n  debug('server certcb done');\x0d\n  try {\x0d\n    socket._handle.certCbDone();\x0d\n  } catch (e) {\x0d\n    debug('server certcb done errored'\x2C e);\x0d\n    socket.destroy(e);\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction onnewsessionclient(sessionId\x2C session) {\x0d\n  debug('client emit session');\x0d\n  const owner = this[owner_symbol];\x0d\n  if (owner[kIsVerified]) {\x0d\n    owner.emit('session'\x2C session);\x0d\n  } else {\x0d\n    owner[kPendingSession] = session;\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction onnewsession(sessionId\x2C session) {\x0d\n  debug('onnewsession');\x0d\n  const owner = this[owner_symbol];\x0d\n\x0d\n  // TODO(@sam-github) no server to emit the event on\x2C but handshake won't\x0d\n  // continue unless newSessionDone() is called\x2C should it be\x2C or is that\x0d\n  // situation unreachable\x2C or only occurring during shutdown?\x0d\n  if (!owner.server)\x0d\n    return;\x0d\n\x0d\n  let once = false;\x0d\n  const done = () => {\x0d\n    debug('onnewsession done');\x0d\n    if (once)\x0d\n      return;\x0d\n    once = true;\x0d\n\x0d\n    if (owner._handle === null)\x0d\n      return owner.destroy(new ERR_SOCKET_CLOSED());\x0d\n\x0d\n    this.newSessionDone();\x0d\n\x0d\n    owner._newSessionPending = false;\x0d\n    if (owner._securePending)\x0d\n      owner._finishInit();\x0d\n    owner._securePending = false;\x0d\n  };\x0d\n\x0d\n  owner._newSessionPending = true;\x0d\n  if (!owner.server.emit('newSession'\x2C sessionId\x2C session\x2C done))\x0d\n    done();\x0d\n}\x0d\n\x0d\nfunction onPskServerCallback(identity\x2C maxPskLen) {\x0d\n  const owner = this[owner_symbol];\x0d\n  const ret = owner[kPskCallback](owner\x2C identity);\x0d\n  if (ret == null)\x0d\n    return undefined;\x0d\n\x0d\n  let psk;\x0d\n  if (isArrayBufferView(ret)) {\x0d\n    psk = ret;\x0d\n  } else {\x0d\n    if (typeof ret !== 'object') {\x0d\n      throw new ERR_INVALID_ARG_TYPE(\x0d\n        'ret'\x2C\x0d\n        ['Object'\x2C 'Buffer'\x2C 'TypedArray'\x2C 'DataView']\x2C\x0d\n        ret\x0d\n      );\x0d\n    }\x0d\n    psk = ret.psk;\x0d\n    validateBuffer(psk\x2C 'psk');\x0d\n  }\x0d\n\x0d\n  if (psk.length > maxPskLen) {\x0d\n    throw new ERR_INVALID_ARG_VALUE(\x0d\n      'psk'\x2C\x0d\n      psk\x2C\x0d\n      `Pre-shared key exceeds ${maxPskLen} bytes`\x0d\n    );\x0d\n  }\x0d\n\x0d\n  return psk;\x0d\n}\x0d\n\x0d\nfunction onPskClientCallback(hint\x2C maxPskLen\x2C maxIdentityLen) {\x0d\n  const owner = this[owner_symbol];\x0d\n  const ret = owner[kPskCallback](hint);\x0d\n  if (ret == null)\x0d\n    return undefined;\x0d\n\x0d\n  validateObject(ret\x2C 'ret');\x0d\n\x0d\n  validateBuffer(ret.psk\x2C 'psk');\x0d\n  if (ret.psk.length > maxPskLen) {\x0d\n    throw new ERR_INVALID_ARG_VALUE(\x0d\n      'psk'\x2C\x0d\n      ret.psk\x2C\x0d\n      `Pre-shared key exceeds ${maxPskLen} bytes`\x0d\n    );\x0d\n  }\x0d\n\x0d\n  validateString(ret.identity\x2C 'identity');\x0d\n  if (Buffer.byteLength(ret.identity) > maxIdentityLen) {\x0d\n    throw new ERR_INVALID_ARG_VALUE(\x0d\n      'identity'\x2C\x0d\n      ret.identity\x2C\x0d\n      `PSK identity exceeds ${maxIdentityLen} bytes`\x0d\n    );\x0d\n  }\x0d\n\x0d\n  return { psk: ret.psk\x2C identity: ret.identity };\x0d\n}\x0d\n\x0d\nfunction onkeylog(line) {\x0d\n  debug('onkeylog');\x0d\n  this[owner_symbol].emit('keylog'\x2C line);\x0d\n}\x0d\n\x0d\nfunction onocspresponse(resp) {\x0d\n  debug('client onocspresponse');\x0d\n  this[owner_symbol].emit('OCSPResponse'\x2C resp);\x0d\n}\x0d\n\x0d\nfunction onerror(err) {\x0d\n  const owner = this[owner_symbol];\x0d\n  debug('%s onerror %s had? %j'\x2C\x0d\n        (typeof owner._tlsOptions === 'object' && owner._tlsOptions !== null) ?\x0d\n          owner._tlsOptions.isServer ? 'server' : 'client' :\x0d\n          'unknown'\x2C\x0d\n        err\x2C owner._hadError);\x0d\n\x0d\n  if (owner._hadError)\x0d\n    return;\x0d\n\x0d\n  owner._hadError = true;\x0d\n\x0d\n  // Destroy socket if error happened before handshake's finish\x0d\n  if (!owner._secureEstablished) {\x0d\n    // When handshake fails control is not yet released\x2C\x0d\n    // so self._tlsError will return null instead of actual error\x0d\n    owner.destroy(err);\x0d\n  } else if (owner._tlsOptions?.isServer &&\x0d\n             owner._rejectUnauthorized &&\x0d\n             RegExpPrototypeTest(/peer did not return a certificate/\x2C\x0d\n                                 err.message)) {\x0d\n    // Ignore server's authorization errors\x0d\n    owner.destroy();\x0d\n  } else {\x0d\n    // Emit error\x0d\n    owner._emitTLSError(err);\x0d\n  }\x0d\n}\x0d\n\x0d\n// Used by both client and server TLSSockets to start data flowing from _handle\x2C\x0d\n// read(0) causes a StreamBase::ReadStart\x2C via Socket._read.\x0d\nfunction initRead(tlsSocket\x2C socket) {\x0d\n  debug('%s initRead'\x2C\x0d\n        tlsSocket._tlsOptions.isServer ? 'server' : 'client'\x2C\x0d\n        'handle?'\x2C !!tlsSocket._handle\x2C\x0d\n        'buffered?'\x2C !!socket && socket.readableLength\x0d\n  );\x0d\n  // If we were destroyed already don't bother reading\x0d\n  if (!tlsSocket._handle)\x0d\n    return;\x0d\n\x0d\n  // Socket already has some buffered data - emulate receiving it\x0d\n  if (socket && socket.readableLength) {\x0d\n    let buf;\x0d\n    while ((buf = socket.read()) !== null)\x0d\n      tlsSocket._handle.receive(buf);\x0d\n  }\x0d\n\x0d\n  tlsSocket.read(0);\x0d\n}\x0d\n\x0d\n/**\x0d\n * Provides a wrap of socket stream to do encrypted communication.\x0d\n */\x0d\n\x0d\nfunction TLSSocket(socket\x2C opts) {\x0d\n  const tlsOptions = { ...opts };\x0d\n  let enableTrace = tlsOptions.enableTrace;\x0d\n\x0d\n  if (enableTrace == null) {\x0d\n    enableTrace = traceTls;\x0d\n\x0d\n    if (enableTrace && !tlsTracingWarned) {\x0d\n      tlsTracingWarned = true;\x0d\n      process.emitWarning('Enabling --trace-tls can expose sensitive data in ' +\x0d\n                          'the resulting log.');\x0d\n    }\x0d\n  } else {\x0d\n    validateBoolean(enableTrace\x2C 'options.enableTrace');\x0d\n  }\x0d\n\x0d\n  if (tlsOptions.ALPNProtocols)\x0d\n    tls.convertALPNProtocols(tlsOptions.ALPNProtocols\x2C tlsOptions);\x0d\n\x0d\n  this._tlsOptions = tlsOptions;\x0d\n  this._secureEstablished = false;\x0d\n  this._securePending = false;\x0d\n  this._newSessionPending = false;\x0d\n  this._controlReleased = false;\x0d\n  this.secureConnecting = true;\x0d\n  this._SNICallback = null;\x0d\n  this.servername = null;\x0d\n  this.alpnProtocol = null;\x0d\n  this.authorized = false;\x0d\n  this.authorizationError = null;\x0d\n  this[kRes] = null;\x0d\n  this[kIsVerified] = false;\x0d\n  this[kPendingSession] = null;\x0d\n\x0d\n  let wrap;\x0d\n  if ((socket instanceof net.Socket && socket._handle) || !socket) {\x0d\n    // 1. connected socket\x0d\n    // 2. no socket\x2C one will be created with net.Socket().connect\x0d\n    wrap = socket;\x0d\n  } else {\x0d\n    // 3. socket has no handle so it is js not c++\x0d\n    // 4. unconnected sockets are wrapped\x0d\n    // TLS expects to interact from C++ with a net.Socket that has a C++ stream\x0d\n    // handle\x2C but a JS stream doesn't have one. Wrap it up to make it look like\x0d\n    // a socket.\x0d\n    wrap = new JSStreamSocket(socket);\x0d\n  }\x0d\n\x0d\n  // Just a documented property to make secure sockets\x0d\n  // distinguishable from regular ones.\x0d\n  this.encrypted = true;\x0d\n\x0d\n  ReflectApply(net.Socket\x2C this\x2C [{\x0d\n    handle: this._wrapHandle(wrap)\x2C\x0d\n    allowHalfOpen: socket ? socket.allowHalfOpen : tlsOptions.allowHalfOpen\x2C\x0d\n    pauseOnCreate: tlsOptions.pauseOnConnect\x2C\x0d\n    manualStart: true\x2C\x0d\n    highWaterMark: tlsOptions.highWaterMark\x2C\x0d\n    onread: !socket ? tlsOptions.onread : null\x2C\x0d\n    signal: tlsOptions.signal\x2C\x0d\n  }]);\x0d\n\x0d\n  // Proxy for API compatibility\x0d\